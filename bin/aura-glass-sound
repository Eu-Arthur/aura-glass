#!/usr/bin/env bash
# aura-glass-sound — organic glass acoustic feedback & sound theme manager.
set -euo pipefail

CONF_DIR="${AURA_GLASS_CONF:-${AURA_GLASS_DIR:-${TAHOE_GLASS_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/aura-glass}}}"
[ -d "$CONF_DIR" ] || [ ! -d "${XDG_CONFIG_HOME:-$HOME/.config}/tahoe-glass" ] || CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tahoe-glass"
SOUND_THEME_DIR="${AURA_GLASS_SOUNDS_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/sounds/aura-glass}"

C_BLD=$'\033[1m'
C_CYA=$'\033[1;36m'
C_GRN=$'\033[1;32m'
C_YEL=$'\033[1;33m'
C_DIM=$'\033[2m'
C_OFF=$'\033[0m'

usage() {
    cat <<'EOF'
aura-glass-sound — tactile glass acoustic feedback & sound theme manager

USAGE:
    aura-glass sound status
    aura-glass sound enable
    aura-glass sound disable
    aura-glass sound preview <bell | screen-capture | window-tile | volume>
    aura-glass sound -h | --help

FEATURES:
    • Pure organic crystal acoustic chimes synthesized natively (zero bloat)
    • High-frequency bell harmonics (1200Hz-2400Hz) with natural exponential decay
    • Conforms to Freedesktop & GNOME sound theme specifications
EOF
}

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
ok()  { printf '✓ %s\n' "$*"; }

generate_sound_files() {
    local target_dir="$1/stereo"
    mkdir -p "$target_dir"

    # 1. Create index.theme
    cat > "$1/index.theme" <<'EOF'
[Sound Theme]
Name=Aura Glass
Comment=Acoustic crystal and tactile glass sound effects for GNOME
Directories=stereo

[stereo]
OutputProfile=stereo
EOF

    # 2. Synthesize audio files with python wave standard library
    python3 -c "
import wave, math, struct, os

target = '$target_dir'
rate = 44100

def write_wav(filename, duration, gen_fn):
    path = os.path.join(target, filename)
    with wave.open(path, 'wb') as wav:
        wav.setnchannels(1)
        wav.setsampwidth(2)
        wav.setframerate(rate)
        total_samples = int(duration * rate)
        frames = bytearray()
        for i in range(total_samples):
            t = i / rate
            val = gen_fn(t, duration)
            sample = int(max(-1.0, min(1.0, val)) * 32767.0)
            frames.extend(struct.pack('<h', sample))
        wav.writeframes(frames)

# 1. bell.wav (crystal droplet chime)
def bell_wave(t, dur):
    decay = math.exp(-t * 9.0)
    # Fundamental 1760Hz + 2nd harmonic 2640Hz + 3rd harmonic 3520Hz
    s1 = math.sin(2 * math.pi * 1760 * t) * 0.65
    s2 = math.sin(2 * math.pi * 2640 * t) * 0.25
    s3 = math.sin(2 * math.pi * 3520 * t) * 0.10
    return (s1 + s2 + s3) * decay * 0.85

write_wav('bell.wav', 0.45, bell_wave)

# 2. screen-capture.wav (double crystal shutter click)
def capture_wave(t, dur):
    decay1 = math.exp(-t * 35.0) if t < 0.08 else 0.0
    decay2 = math.exp(-(t - 0.08) * 35.0) if t >= 0.08 else 0.0
    s1 = math.sin(2 * math.pi * 1400 * t) * decay1 * 0.7
    s2 = math.sin(2 * math.pi * 1800 * (t - 0.08)) * decay2 * 0.9 if t >= 0.08 else 0.0
    return s1 + s2

write_wav('screen-capture.wav', 0.18, capture_wave)

# 3. window-tile.wav (soft magnetic glass snap)
def snap_wave(t, dur):
    decay = math.exp(-t * 22.0)
    freq = 900 + 400 * (1.0 - t / dur)
    return math.sin(2 * math.pi * freq * t) * decay * 0.75

write_wav('window-tile.wav', 0.14, snap_wave)

# 4. audio-volume-change.wav (delicate crystal tick)
def tick_wave(t, dur):
    decay = math.exp(-t * 70.0)
    return math.sin(2 * math.pi * 2200 * t) * decay * 0.6

write_wav('audio-volume-change.wav', 0.06, tick_wave)
"
}

cmd_status() {
    printf '%sGlass Acoustic Sound Theme Status:%s\n\n' "$C_BLD" "$C_OFF"

    local current_theme="default"
    local event_sounds="false"
    if command -v gsettings >/dev/null 2>&1 && gsettings list-schemas 2>/dev/null | grep -q '^org\.gnome\.desktop\.sound$'; then
        current_theme="$(gsettings get org.gnome.desktop.sound theme-name 2>/dev/null || echo "default")"
        current_theme="${current_theme//\'/}"
        event_sounds="$(gsettings get org.gnome.desktop.sound event-sounds 2>/dev/null || echo "false")"
    fi

    local is_active="${C_DIM}inactive${C_OFF}"
    if { [ "$current_theme" = "aura-glass" ] && [ "$event_sounds" = "true" ]; } || [ -f "$CONF_DIR/sound-theme-active" ]; then
        is_active="${C_GRN}active (enabled)${C_OFF}"
    fi

    printf '  Status:          %s\n' "$is_active"
    printf '  Active Theme:    %s%s%s\n' "$C_CYA" "$current_theme" "$C_OFF"
    printf '  Event Sounds:    %s\n' "$event_sounds"
    printf '  Theme Directory: %s\n' "$SOUND_THEME_DIR"

    if [ -f "$SOUND_THEME_DIR/stereo/bell.wav" ]; then
        printf '  Synthesized:     %s4 crystal acoustic files present%s\n' "$C_GRN" "$C_OFF"
    else
        printf '  Synthesized:     %snot installed yet%s\n' "$C_DIM" "$C_OFF"
    fi
}

cmd_enable() {
    generate_sound_files "$SOUND_THEME_DIR"
    mkdir -p "$CONF_DIR"
    touch "$CONF_DIR/sound-theme-active"

    if command -v gsettings >/dev/null 2>&1 && gsettings list-schemas 2>/dev/null | grep -q '^org\.gnome\.desktop\.sound$'; then
        gsettings set org.gnome.desktop.sound event-sounds true 2>/dev/null || true
        gsettings set org.gnome.desktop.sound theme-name 'aura-glass' 2>/dev/null || true
        ok "Aura Glass acoustic sound theme enabled."
    else
        ok "Aura Glass sound files generated at $SOUND_THEME_DIR."
    fi
}

cmd_disable() {
    rm -f "$CONF_DIR/sound-theme-active"
    if command -v gsettings >/dev/null 2>&1 && gsettings list-schemas 2>/dev/null | grep -q '^org\.gnome\.desktop\.sound$'; then
        gsettings set org.gnome.desktop.sound theme-name 'freedesktop' 2>/dev/null || true
        ok "Restored default sound theme (freedesktop)."
    else
        ok "Sound theme disabled."
    fi
}

cmd_preview() {
    local event="${1:-bell}"
    local wav_name="$event"
    case "$event" in
        bell|notification) wav_name="bell.wav" ;;
        screen-capture|screenshot) wav_name="screen-capture.wav" ;;
        window-tile|snap) wav_name="window-tile.wav" ;;
        volume|tick) wav_name="audio-volume-change.wav" ;;
        *) wav_name="$event.wav" ;;
    esac

    local wav_path="$SOUND_THEME_DIR/stereo/$wav_name"
    if [ ! -f "$wav_path" ]; then
        generate_sound_files "$SOUND_THEME_DIR"
    fi

    printf 'Playing %s... ' "$wav_name"
    if command -v paplay >/dev/null 2>&1; then
        paplay "$wav_path" 2>/dev/null || true
    elif command -v pw-cat >/dev/null 2>&1; then
        pw-cat -p "$wav_path" 2>/dev/null || true
    elif command -v aplay >/dev/null 2>&1; then
        aplay -q "$wav_path" 2>/dev/null || true
    elif command -v canberra-gtk-play >/dev/null 2>&1; then
        canberra-gtk-play -f "$wav_path" 2>/dev/null || true
    fi
    printf '%s[ OK ]%s\n' "$C_GRN" "$C_OFF"
}

main() {
    local action="${1:-status}"
    shift || true

    case "$action" in
        status) cmd_status ;;
        enable) cmd_enable ;;
        disable) cmd_disable ;;
        preview) cmd_preview "$@" ;;
        -h|--help|help) usage ;;
        *) die "unknown action '$action'. Run 'aura-glass sound --help' for usage." ;;
    esac
}

main "$@"
