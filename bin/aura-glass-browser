#!/usr/bin/env bash
# aura-glass-browser — frosted glass styling integration for Firefox and web browsers.
set -euo pipefail

CONF_DIR="${AURA_GLASS_CONF:-${AURA_GLASS_DIR:-${TAHOE_GLASS_DIR:-$HOME/.config/aura-glass}}}"
[ -d "$CONF_DIR" ] || [ ! -d "$HOME/.config/tahoe-glass" ] || CONF_DIR="$HOME/.config/tahoe-glass"

C_BLD=$'\033[1m'
C_CYA=$'\033[1;36m'
C_GRN=$'\033[1;32m'
C_YEL=$'\033[1;33m'
C_DIM=$'\033[2m'
C_OFF=$'\033[0m'

usage() {
    cat <<'EOF'
aura-glass-browser — frosted glass theme integrator for Firefox

USAGE:
    aura-glass browser status
    aura-glass browser firefox enable
    aura-glass browser firefox disable
    aura-glass browser firefox sync
    aura-glass browser firefox snippet
    aura-glass browser -h | --help

FEATURES:
    • Native userChrome.css with backdrop-filter blur shaders
    • Dynamic accent color matching Aura Glass system palette
    • Smooth rounded tab bar and navigation toolbar
    • Multi-profile support (Native, Flatpak, and Snap Firefox)
EOF
}

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
ok()  { printf '✓ %s\n' "$*"; }

get_accent_hex() {
    local acc="blue"
    if [ -r "$CONF_DIR/accent" ]; then
        acc="$(head -n 1 "$CONF_DIR/accent" 2>/dev/null || echo "blue")"
    fi

    case "$acc" in
        purple) echo "#9141ac" ;;
        blue)   echo "#3584e4" ;;
        teal)   echo "#2190a4" ;;
        green)  echo "#3a944a" ;;
        yellow) echo "#c88800" ;;
        orange) echo "#ed5b00" ;;
        red)    echo "#e62d42" ;;
        pink)   echo "#d56199" ;;
        slate)  echo "#6f8396" ;;
        *)
            if [[ "$acc" =~ ^#[0-9a-fA-F]{6}$ ]]; then
                echo "$acc"
            else
                echo "#3584e4"
            fi
            ;;
    esac
}

get_radius() {
    local rad="14px"
    if [ -r "$CONF_DIR/radius-preset" ]; then
        local r
        r="$(head -n 1 "$CONF_DIR/radius-preset" 2>/dev/null || echo "default")"
        case "$r" in
            sharp|flat) rad="6px" ;;
            adwaita)    rad="12px" ;;
            soft)       rad="16px" ;;
            medium)     rad="20px" ;;
            rounded)    rad="24px" ;;
            default|*)  rad="14px" ;;
        esac
    fi
    echo "$rad"
}

find_firefox_profiles() {
    local root_dirs=(
        "${MOZ_CONFIG_HOME:-$HOME/.mozilla/firefox}"
        "$HOME/.var/app/org.mozilla.firefox/.mozilla/firefox"
        "$HOME/snap/firefox/common/.mozilla/firefox"
    )

    local found=()
    for root in "${root_dirs[@]}"; do
        [ -d "$root" ] || continue
        for d in "$root"/*; do
            [ -d "$d" ] || continue
            # Check for profile signs (prefs.js, times.json, or .default in name)
            if [ -f "$d/prefs.js" ] || [ -f "$d/times.json" ] || [[ "${d##*/}" == *".default"* ]]; then
                found+=("$d")
            fi
        done
    done

    printf '%s\n' "${found[@]}"
}

generate_userchrome_css() {
    local accent_hex
    accent_hex="$(get_accent_hex)"
    local radius
    radius="$(get_radius)"

    cat <<EOF
/* ==========================================================================
   Aura Glass — Frosted Glass Theme for Firefox
   Generated automatically by aura-glass browser
   ========================================================================== */

:root {
  --aura-glass-accent: $accent_hex;
  --aura-glass-radius: $radius;
  --aura-glass-bg: rgba(26, 28, 35, 0.72);
  --aura-glass-border: rgba(255, 255, 255, 0.12);
}

/* Translucent Main Window & Toolbars */
#main-window,
#navigator-toolbox,
#TabsToolbar,
#nav-bar {
  background-color: var(--aura-glass-bg) !important;
  backdrop-filter: blur(24px) saturate(140%) !important;
  -webkit-backdrop-filter: blur(24px) saturate(140%) !important;
  border-bottom: 1px solid var(--aura-glass-border) !important;
}

/* Floating Rounded URL Bar */
#urlbar-background {
  background-color: rgba(255, 255, 255, 0.08) !important;
  border-radius: var(--aura-glass-radius) !important;
  border: 1px solid var(--aura-glass-border) !important;
}

#urlbar[focused="true"] > #urlbar-background {
  border-color: var(--aura-glass-accent) !important;
  box-shadow: 0 0 0 2px var(--aura-glass-accent) !important;
}

/* Frosted Tabs */
.tabbrowser-tab .tab-background {
  border-radius: var(--aura-glass-radius) !important;
  transition: background-color 0.2s ease, border-color 0.2s ease !important;
}

.tabbrowser-tab[selected="true"] .tab-background {
  background-color: rgba(255, 255, 255, 0.14) !important;
  border: 1px solid var(--aura-glass-border) !important;
}

.tabbrowser-tab:hover:not([selected="true"]) .tab-background {
  background-color: rgba(255, 255, 255, 0.06) !important;
}

/* Active Accent Tab Line */
.tabbrowser-tab[selected="true"] .tab-line {
  background-color: var(--aura-glass-accent) !important;
  height: 2px !important;
  border-radius: 2px !important;
}
EOF
}

cmd_status() {
    printf '%sFirefox Frosted Glass Theme Status:%s\n\n' "$C_BLD" "$C_OFF"

    local profiles
    mapfile -t profiles < <(find_firefox_profiles)

    if [ "${#profiles[@]}" -eq 0 ]; then
        printf '  %sNo Firefox profiles detected.%s\n' "$C_YEL" "$C_OFF"
        printf '  (Checked ~/.mozilla/firefox, Flatpak, and Snap locations)\n'
        return 0
    fi

    printf '  %-45s %-12s %s\n' "PROFILE PATH" "THEME" "USER.JS PREF"
    printf '  %-45s %-12s %s\n' "─────────────────────────────────────────────" "────────────" "────────────"

    for p in "${profiles[@]}"; do
        [ -n "$p" ] || continue
        local p_name="${p##*/}"
        local has_css="${C_DIM}disabled${C_OFF}"
        local has_pref="${C_DIM}no${C_OFF}"

        if [ -f "$p/chrome/userChrome.css" ]; then
            if grep -q "Aura Glass" "$p/chrome/userChrome.css" 2>/dev/null; then
                has_css="${C_GRN}active${C_OFF}"
            else
                has_css="${C_YEL}custom css${C_OFF}"
            fi
        fi

        if [ -f "$p/user.js" ] && grep -q "toolkit.legacyUserProfileCustomizations.stylesheets" "$p/user.js" 2>/dev/null; then
            has_pref="${C_GRN}yes${C_OFF}"
        fi

        printf '  %-45s %-21s %s\n' "$p_name" "$has_css" "$has_pref"
    done

    local acc_hex
    acc_hex="$(get_accent_hex)"
    local rad
    rad="$(get_radius)"
    printf '\n  Current Theme Tokens: Accent %s%s%s, Radius %s\n' "$C_CYA" "$acc_hex" "$C_OFF" "$rad"
    printf '  %sRun "aura-glass browser firefox enable" to install or "sync" to update.%s\n' "$C_DIM" "$C_OFF"
}

cmd_enable() {
    local profiles
    mapfile -t profiles < <(find_firefox_profiles)

    if [ "${#profiles[@]}" -eq 0 ]; then
        die "No Firefox profile found. Start Firefox at least once to create a default profile."
    fi

    local css_content
    css_content="$(generate_userchrome_css)"
    local count=0

    for p in "${profiles[@]}"; do
        [ -n "$p" ] || continue
        mkdir -p "$p/chrome"
        local css_file="$p/chrome/userChrome.css"

        if [ -f "$css_file" ] && [ ! -f "$css_file.aurabackup" ]; then
            cp -f "$css_file" "$css_file.aurabackup"
        fi

        printf '%s\n' "$css_content" > "$css_file"

        # Ensure user.js enables custom stylesheet loading
        local user_js="$p/user.js"
        if [ ! -f "$user_js" ] || ! grep -q "toolkit.legacyUserProfileCustomizations.stylesheets" "$user_js" 2>/dev/null; then
            cat >> "$user_js" <<'EOF'
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);
user_pref("layout.css.backdrop-filter.enabled", true);
EOF
        fi
        count=$((count + 1))
    done

    ok "Frosted glass theme installed in $count Firefox profile(s)."
    printf '%sRestart Firefox to view your frosted glass theme!%s\n' "$C_CYA" "$C_OFF"
}

cmd_disable() {
    local profiles
    mapfile -t profiles < <(find_firefox_profiles)
    local count=0

    for p in "${profiles[@]}"; do
        [ -n "$p" ] || continue
        local css_file="$p/chrome/userChrome.css"
        if [ -f "$css_file" ]; then
            if [ -f "$css_file.aurabackup" ]; then
                mv -f "$css_file.aurabackup" "$css_file"
            else
                rm -f "$css_file"
            fi
            count=$((count + 1))
        fi
    done

    ok "Removed Aura Glass theme from $count Firefox profile(s)."
}

cmd_sync() {
    cmd_enable
}

main() {
    local target="${1:-status}"
    shift || true

    case "$target" in
        status)
            cmd_status
            ;;
        firefox)
            local action="${1:-status}"
            shift || true
            case "$action" in
                enable|install) cmd_enable ;;
                disable|remove) cmd_disable ;;
                sync|update) cmd_sync ;;
                snippet) generate_userchrome_css ;;
                status) cmd_status ;;
                *) die "unknown action '$action'. Usage: aura-glass browser firefox [enable|disable|sync|snippet|status]" ;;
            esac
            ;;
        snippet)
            generate_userchrome_css
            ;;
        -h|--help|help)
            usage
            ;;
        *)
            die "unknown browser or action '$target'. Run 'aura-glass browser --help' for usage."
            ;;
    esac
}

main "$@"
