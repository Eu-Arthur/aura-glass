#!/usr/bin/env bash
# aura-glass-wallpaper — procedural 4K mesh gradient & aurora wallpaper generator.
set -euo pipefail

CONF_DIR="${AURA_GLASS_CONF:-${AURA_GLASS_DIR:-${TAHOE_GLASS_DIR:-$HOME/.config/aura-glass}}}"
[ -d "$CONF_DIR" ] || [ ! -d "$HOME/.config/tahoe-glass" ] || CONF_DIR="$HOME/.config/tahoe-glass"
WALLPAPER_DIR="${AURA_GLASS_WALLPAPER_DIR:-$HOME/Pictures/Wallpapers/AuraGlass}"

C_BLD=$'\033[1m'
C_CYA=$'\033[1;36m'
C_GRN=$'\033[1;32m'
C_YEL=$'\033[1;33m'
C_DIM=$'\033[2m'
C_OFF=$'\033[0m'

usage() {
    cat <<'EOF'
aura-glass-wallpaper — procedural 4K mesh gradient & aurora wallpaper generator

USAGE:
    aura-glass wallpaper generate [OPTIONS]
    aura-glass wallpaper apply <image_path>
    aura-glass wallpaper current
    aura-glass wallpaper -h | --help

OPTIONS:
    --mesh         Generate fluid multi-point mesh gradient (default)
    --aurora       Generate luminous aurora borealis ribbons on deep night sky
    --obsidian     Generate dark minimal obsidian glass surface with accent glow
    --accent <col> Color accent (blue, teal, green, yellow, orange, red, pink, purple, slate)
    --width <px>   Target image width (default: 3840)
    --height <px>  Target image height (default: 2160)
    --output <f>   Save output directly to specific file path
    --apply        Set generated wallpaper as active desktop wallpaper immediately
    -h, --help     Show this help message
EOF
}

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
ok()  { printf '✓ %s\n' "$*"; }

get_current_accent() {
    if [ -r "$CONF_DIR/accent" ]; then
        head -n 1 "$CONF_DIR/accent" 2>/dev/null || echo "blue"
    else
        echo "blue"
    fi
}

get_current_wallpaper() {
    if command -v gsettings >/dev/null 2>&1 && gsettings list-schemas 2>/dev/null | grep -q '^org\.gnome\.desktop\.background$'; then
        local uri
        uri="$(gsettings get org.gnome.desktop.background picture-uri 2>/dev/null || echo "''")"
        uri="${uri//\'/}"
        uri="${uri#file://}"
        echo "$uri"
    else
        echo ""
    fi
}

cmd_apply() {
    local target="${1:-}"
    [ -n "$target" ] || die "missing wallpaper path. Usage: aura-glass wallpaper apply <image_path>"
    [ -f "$target" ] || die "file not found: $target"

    local abs_path
    abs_path="$(cd "$(dirname "$target")" && pwd)/$(basename "$target")"

    if command -v gsettings >/dev/null 2>&1 && gsettings list-schemas 2>/dev/null | grep -q '^org\.gnome\.desktop\.background$'; then
        gsettings set org.gnome.desktop.background picture-uri "file://$abs_path" 2>/dev/null || true
        gsettings set org.gnome.desktop.background picture-uri-dark "file://$abs_path" 2>/dev/null || true
        gsettings set org.gnome.desktop.background picture-options "zoom" 2>/dev/null || true
        ok "Desktop wallpaper applied: $abs_path"
    else
        printf 'gsettings desktop background schema not found. File saved at: %s\n' "$abs_path"
    fi

    # Trigger GDM lockscreen sync if available
    if command -v aura-glass-gdm-sync >/dev/null 2>&1; then
        aura-glass-gdm-sync >/dev/null 2>&1 || true
    fi
}

cmd_generate() {
    local style="mesh"
    local accent=""
    local width=3840
    local height=2160
    local output=""
    local do_apply=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --mesh) style="mesh"; shift ;;
            --aurora) style="aurora"; shift ;;
            --obsidian) style="obsidian"; shift ;;
            --accent) accent="${2:-}"; shift 2 ;;
            --width) width="${2:-3840}"; shift 2 ;;
            --height) height="${2:-2160}"; shift 2 ;;
            --output) output="${2:-}"; shift 2 ;;
            --apply) do_apply=1; shift ;;
            -h|--help) usage; exit 0 ;;
            *) shift ;;
        esac
    done

    [ -n "$accent" ] || accent="$(get_current_accent)"

    mkdir -p "$WALLPAPER_DIR"
    if [ -z "$output" ]; then
        local timestamp
        timestamp="$(date +'%Y%m%d_%H%M%S')"
        output="$WALLPAPER_DIR/aura_${style}_${accent}_${timestamp}.png"
    fi

    mkdir -p "$(dirname "$output")"

    printf '%sGenerating %s 4K procedural wallpaper (%s style, %s accent)...%s\n' \
        "$C_BLD" "${width}x${height}" "$style" "$accent" "$C_OFF"

    python3 -c "
import sys, math, random
from PIL import Image, ImageDraw, ImageFilter

style = '$style'
accent = '$accent'
w = int('$width')
h = int('$height')
outfile = '$output'

PALETTES = {
    'blue':   {'primary': (53, 132, 228),  'secondary': (28, 113, 216), 'highlight': (98, 160, 234)},
    'teal':   {'primary': (33, 144, 164),  'secondary': (26, 95, 122),  'highlight': (53, 185, 206)},
    'green':  {'primary': (58, 148, 74),   'secondary': (38, 162, 105), 'highlight': (94, 202, 118)},
    'yellow': {'primary': (200, 136, 0),   'secondary': (229, 165, 10), 'highlight': (246, 211, 45)},
    'orange': {'primary': (237, 91, 0),    'secondary': (198, 70, 0),   'highlight': (255, 120, 0)},
    'red':    {'primary': (230, 45, 66),   'secondary': (192, 28, 40),  'highlight': (246, 97, 81)},
    'pink':   {'primary': (213, 97, 153),  'secondary': (177, 43, 117), 'highlight': (229, 136, 178)},
    'purple': {'primary': (145, 65, 172),  'secondary': (129, 61, 156), 'highlight': (192, 97, 203)},
    'slate':  {'primary': (111, 131, 150), 'secondary': (77, 99, 118),  'highlight': (154, 175, 194)},
}

pal = PALETTES.get(accent, PALETTES['blue'])
p_rgb = pal['primary']
s_rgb = pal['secondary']
h_rgb = pal['highlight']

# Generate at half scale then scale up with smooth filter for speed & blur softness
sw = max(320, w // 4)
sh = max(180, h // 4)

if style == 'obsidian':
    base = Image.new('RGB', (sw, sh), (18, 20, 26))
    draw = ImageDraw.Draw(base)
    # Subtle deep glow
    draw.ellipse([sw * 0.2, sh * 0.3, sw * 0.8, sh * 0.9], fill=(p_rgb[0]//3, p_rgb[1]//3, p_rgb[2]//3))
    draw.ellipse([sw * 0.4, sh * 0.1, sw * 0.9, sh * 0.7], fill=(s_rgb[0]//4, s_rgb[1]//4, s_rgb[2]//4))
elif style == 'aurora':
    base = Image.new('RGB', (sw, sh), (12, 14, 22))
    draw = ImageDraw.Draw(base)
    # Sinuous ribbon patches
    draw.ellipse([sw * 0.1, sh * 0.2, sw * 0.7, sh * 0.6], fill=p_rgb)
    draw.ellipse([sw * 0.3, sh * 0.4, sw * 0.9, sh * 0.8], fill=s_rgb)
    draw.ellipse([sw * 0.5, sh * 0.1, sw * 1.1, sh * 0.5], fill=h_rgb)
else: # mesh
    base = Image.new('RGB', (sw, sh), (24, 28, 40))
    draw = ImageDraw.Draw(base)
    draw.ellipse([-sw * 0.2, -sh * 0.2, sw * 0.7, sh * 0.7], fill=s_rgb)
    draw.ellipse([sw * 0.4, -sh * 0.1, sw * 1.2, sh * 0.8], fill=h_rgb)
    draw.ellipse([sw * 0.1, sh * 0.4, sw * 0.9, sh * 1.2], fill=p_rgb)
    draw.ellipse([sw * 0.6, sh * 0.5, sw * 1.3, sh * 1.3], fill=(30, 38, 55))

# Apply multi-pass smooth gaussian blur
blurred = base.filter(ImageFilter.GaussianBlur(radius=sw // 6))
blurred = blurred.filter(ImageFilter.GaussianBlur(radius=sw // 8))

# Resize to target resolution with Bicubic resampling
final_img = blurred.resize((w, h), Image.Resampling.BICUBIC)

final_img.save(outfile, 'PNG', optimize=True)
"

    ok "Wallpaper generated: $output"

    if [ "$do_apply" -eq 1 ]; then
        cmd_apply "$output"
    fi
}

main() {
    local action="${1:-generate}"
    shift || true

    case "$action" in
        generate) cmd_generate "$@" ;;
        apply) cmd_apply "$@" ;;
        current)
            local cur
            cur="$(get_current_wallpaper)"
            if [ -n "$cur" ]; then
                printf 'Current Wallpaper: %s\n' "$cur"
            else
                printf 'No active wallpaper URI detected.\n'
            fi
            ;;
        -h|--help|help) usage ;;
        *)
            if [ -f "$action" ]; then
                cmd_apply "$action" "$@"
            else
                die "unknown action '$action'. Run 'aura-glass wallpaper --help' for usage."
            fi
            ;;
    esac
}

main "$@"
