#!/usr/bin/env bash
# aura-glass-profile — visual atmosphere & desktop presets manager.
set -euo pipefail

CONF_DIR="${AURA_GLASS_CONF:-${AURA_GLASS_DIR:-${TAHOE_GLASS_DIR:-$HOME/.config/aura-glass}}}"
[ -d "$CONF_DIR" ] || [ ! -d "$HOME/.config/tahoe-glass" ] || CONF_DIR="$HOME/.config/tahoe-glass"
PROFILES_DIR="$CONF_DIR/profiles"

# Guard: Refuse running as root
if [ "$(id -u)" -eq 0 ]; then
    printf 'error: aura-glass-profile manages user desktop styling and must not be run as root.\n' >&2
    exit 1
fi

C_BLD=$'\033[1m'
C_BLU=$'\033[1;34m'
C_CYA=$'\033[1;36m'
C_GRN=$'\033[1;32m'
C_YEL=$'\033[1;33m'
C_DIM=$'\033[2m'
C_OFF=$'\033[0m'

BUILTIN_PROFILES=(
    "sonoma|Sonoma|frosted|soft|blue|Balanced macOS-style frosted glass with soft 16px corners"
    "visionos|visionOS|frosted|medium|auto|Crystalline specular glass with dynamic wallpaper accent and 22px corners"
    "nordic|Nordic|frosted|adwaita|slate|Cool slate tinted frosted glass with compact 12px Libadwaita corners"
    "minimal|Minimal|transparent|sharp|auto|Clean translucent surfaces without background blur and sharp corners"
    "cyberpunk|Cyberpunk|frosted|rounded|pink|Vibrant neon-tinted glass with rounded 38px corners"
    "eco|Eco|eco|default|auto|Maximum battery preservation with lightweight shaders"
)

usage() {
    cat <<'EOF'
aura-glass-profile — visual atmosphere and desktop profile manager

USAGE:
    aura-glass profile list [--json]
    aura-glass profile apply <name>
    aura-glass profile save <name> [--description "text"]
    aura-glass profile current [--json]
    aura-glass profile export <name> [file]
    aura-glass profile import <file>
    aura-glass profile remove <name>
    aura-glass profile -h | --help

BUILT-IN PROFILES:
    sonoma       macOS Sonoma-like frosted glass, soft 16px corners, blue accent
    visionos     visionOS crystalline glass, medium 22px corners, auto accent
    nordic       Dense cool slate glass, adwaita 12px corners, slate accent
    minimal      Ultra-light translucent, sharp corners, no background blur
    cyberpunk    Vibrant neon ambiance, rounded 38px corners, pink accent
    eco          Power-saving preset with battery-conscious transparent shaders
EOF
}

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
ok()  { printf '✓ %s\n' "$*"; }

get_current_state() {
    local mode="frosted"
    if [ -f "$CONF_DIR/styling-off" ]; then
        mode="solid"
    elif [ -r "$CONF_DIR/glass-mode" ]; then
        mode="$(head -n 1 "$CONF_DIR/glass-mode" 2>/dev/null || echo "frosted")"
    fi

    local radius="default"
    if [ -r "$CONF_DIR/radius-preset" ]; then
        radius="$(head -n 1 "$CONF_DIR/radius-preset" 2>/dev/null || echo "default")"
    fi

    local accent="auto"
    if [ -r "$CONF_DIR/accent" ]; then
        accent="$(head -n 1 "$CONF_DIR/accent" 2>/dev/null || echo "auto")"
    fi

    local active_profile="custom"
    if [ -r "$CONF_DIR/current-profile" ]; then
        active_profile="$(head -n 1 "$CONF_DIR/current-profile" 2>/dev/null || echo "custom")"
    fi

    printf '%s|%s|%s|%s\n' "$active_profile" "$mode" "$radius" "$accent"
}

cmd_current() {
    local as_json=0
    for arg in "$@"; do
        [ "$arg" = "--json" ] && as_json=1
    done

    local cur
    cur="$(get_current_state)"
    IFS='|' read -r cur_prof cur_mode cur_radius cur_accent <<< "$cur"

    if [ "$as_json" -eq 1 ]; then
        printf '{"profile":"%s","mode":"%s","radius":"%s","accent":"%s"}\n' \
            "$cur_prof" "$cur_mode" "$cur_radius" "$cur_accent"
    else
        printf '%sActive Atmosphere Profile:%s %s%s%s\n' "$C_BLD" "$C_OFF" "$C_CYA" "$cur_prof" "$C_OFF"
        printf '  • Glass Mode:     %s\n' "$cur_mode"
        printf '  • Corner Radius:  %s\n' "$cur_radius"
        printf '  • Accent Color:   %s\n' "$cur_accent"
    fi
}

find_profile() {
    local target="$1"
    # 1. Check built-ins
    for row in "${BUILTIN_PROFILES[@]}"; do
        IFS='|' read -r id name mode radius accent desc <<< "$row"
        if [ "$id" = "$target" ]; then
            printf 'builtin|%s|%s|%s|%s|%s|%s\n' "$id" "$name" "$mode" "$radius" "$accent" "$desc"
            return 0
        fi
    done

    # 2. Check user profiles directory
    local user_file="$PROFILES_DIR/$target.json"
    if [ -f "$user_file" ]; then
        local p_name p_mode p_radius p_accent p_desc
        p_name="$(python3 -c "import json; d=json.load(open('$user_file')); print(d.get('name', '$target'))" 2>/dev/null || echo "$target")"
        p_mode="$(python3 -c "import json; d=json.load(open('$user_file')); print(d.get('mode', 'frosted'))" 2>/dev/null || echo "frosted")"
        p_radius="$(python3 -c "import json; d=json.load(open('$user_file')); print(d.get('radius', 'default'))" 2>/dev/null || echo "default")"
        p_accent="$(python3 -c "import json; d=json.load(open('$user_file')); print(d.get('accent', 'auto'))" 2>/dev/null || echo "auto")"
        p_desc="$(python3 -c "import json; d=json.load(open('$user_file')); print(d.get('description', 'User custom profile'))" 2>/dev/null || echo "User custom profile")"
        printf 'custom|%s|%s|%s|%s|%s|%s\n' "$target" "$p_name" "$p_mode" "$p_radius" "$p_accent" "$p_desc"
        return 0
    fi

    return 1
}

cmd_list() {
    local as_json=0
    for arg in "$@"; do
        [ "$arg" = "--json" ] && as_json=1
    done

    local cur
    cur="$(get_current_state)"
    IFS='|' read -r cur_prof _ _ _ <<< "$cur"

    if [ "$as_json" -eq 1 ]; then
        python3 - <<PY
import os, json

builtins = [
    {"id": "sonoma", "name": "Sonoma", "mode": "frosted", "radius": "soft", "accent": "blue", "description": "Balanced macOS-style frosted glass with soft 16px corners", "type": "builtin"},
    {"id": "visionos", "name": "visionOS", "mode": "frosted", "radius": "medium", "accent": "auto", "description": "Crystalline specular glass with dynamic wallpaper accent and 22px corners", "type": "builtin"},
    {"id": "nordic", "name": "Nordic", "mode": "frosted", "radius": "adwaita", "accent": "slate", "description": "Cool slate tinted frosted glass with compact 12px Libadwaita corners", "type": "builtin"},
    {"id": "minimal", "name": "Minimal", "mode": "transparent", "radius": "sharp", "accent": "auto", "description": "Clean translucent surfaces without background blur and sharp corners", "type": "builtin"},
    {"id": "cyberpunk", "name": "Cyberpunk", "mode": "frosted", "radius": "rounded", "accent": "pink", "description": "Vibrant neon-tinted glass with rounded 38px corners", "type": "builtin"},
    {"id": "eco", "name": "Eco", "mode": "eco", "radius": "default", "accent": "auto", "description": "Maximum battery preservation with lightweight shaders", "type": "builtin"},
]

pdir = "$PROFILES_DIR"
custom = []
if os.path.isdir(pdir):
    for f in sorted(os.listdir(pdir)):
        if f.endswith('.json'):
            try:
                with open(os.path.join(pdir, f), 'r', encoding='utf-8') as fp:
                    item = json.load(fp)
                    item['id'] = f[:-5]
                    item['type'] = 'custom'
                    custom.append(item)
            except Exception:
                pass

print(json.dumps({"current": "$cur_prof", "profiles": builtins + custom}, indent=2))
PY
        return 0
    fi

    printf '%sAvailable Atmosphere Profiles:%s\n\n' "$C_BLD" "$C_OFF"
    printf '  %-12s %-10s %-10s %-8s %s\n' "ID" "MODE" "RADIUS" "ACCENT" "DESCRIPTION"
    printf '  %-12s %-10s %-10s %-8s %s\n' "────────────" "──────────" "──────────" "────────" "──────────────────────────────────"

    # Builtin profiles
    for row in "${BUILTIN_PROFILES[@]}"; do
        IFS='|' read -r id _ mode radius accent desc <<< "$row"
        local mark=" "
        local color_id="$C_CYA$id$C_OFF"
        if [ "$id" = "$cur_prof" ]; then
            mark="${C_GRN}●${C_OFF}"
            color_id="${C_GRN}${C_BLD}$id${C_OFF}"
        fi
        printf '%s %-21s %-10s %-10s %-8s %s%s%s\n' "$mark" "$color_id" "$mode" "$radius" "$accent" "$C_DIM" "$desc" "$C_OFF"
    done

    # Custom profiles
    if [ -d "$PROFILES_DIR" ] && [ -n "$(ls -A "$PROFILES_DIR" 2>/dev/null)" ]; then
        printf '\n%sCustom User Profiles:%s\n' "$C_BLD" "$C_OFF"
        for f in "$PROFILES_DIR"/*.json; do
            [ -f "$f" ] || continue
            local id
            id="$(basename "$f" .json)"
            local p_mode p_radius p_accent p_desc
            p_mode="$(python3 -c "import json; d=json.load(open('$f')); print(d.get('mode', 'frosted'))" 2>/dev/null || echo "frosted")"
            p_radius="$(python3 -c "import json; d=json.load(open('$f')); print(d.get('radius', 'default'))" 2>/dev/null || echo "default")"
            p_accent="$(python3 -c "import json; d=json.load(open('$f')); print(d.get('accent', 'auto'))" 2>/dev/null || echo "auto")"
            p_desc="$(python3 -c "import json; d=json.load(open('$f')); print(d.get('description', ''))" 2>/dev/null || true)"
            local mark=" "
            local color_id="$C_BLU$id$C_OFF"
            if [ "$id" = "$cur_prof" ]; then
                mark="${C_GRN}●${C_OFF}"
                color_id="${C_GRN}${C_BLD}$id${C_OFF}"
            fi
            printf '%s %-21s %-10s %-10s %-8s %s%s%s\n' "$mark" "$color_id" "$p_mode" "$p_radius" "$p_accent" "$C_DIM" "$p_desc" "$C_OFF"
        done
    fi
    printf '\n%sHint: Switch with %saura-glass profile apply <name>%s\n' "$C_DIM" "$C_CYA" "$C_OFF"
}

cmd_apply() {
    local target="${1:-}"
    [ -n "$target" ] || die "missing profile name. Run 'aura-glass profile list' to see available presets."

    local prof_info
    prof_info="$(find_profile "$target")" || die "profile '$target' not found."

    IFS='|' read -r _ id name mode radius accent desc <<< "$prof_info"

    printf '%sApplying atmosphere profile:%s %s%s%s (%s)\n' "$C_BLD" "$C_OFF" "$C_CYA" "$name" "$C_OFF" "$desc"

    # 1. Apply Glass Mode
    if command -v aura-glass-mode >/dev/null 2>&1; then
        aura-glass-mode set "$mode" >/dev/null 2>&1 || true
    else
        mkdir -p "$CONF_DIR"
        if [ "$mode" = "solid" ]; then
            printf '1\n' > "$CONF_DIR/styling-off"
        else
            rm -f "$CONF_DIR/styling-off"
            printf '%s\n' "$mode" > "$CONF_DIR/glass-mode"
        fi
    fi

    # 2. Apply Radius Preset
    mkdir -p "$CONF_DIR"
    printf '%s\n' "$radius" > "$CONF_DIR/radius-preset"

    # 3. Apply Accent Color
    if [ "$accent" = "auto" ]; then
        if command -v aura-glass >/dev/null 2>&1; then
            aura-glass accent auto >/dev/null 2>&1 || true
        fi
    else
        printf '%s\n' "$accent" > "$CONF_DIR/accent"
        rm -f "$CONF_DIR/accent-from-wallpaper" 2>/dev/null || true
        if command -v gsettings >/dev/null 2>&1 && gsettings list-schemas 2>/dev/null | grep -q '^org\.gnome\.desktop\.interface$'; then
            if gsettings list-keys org.gnome.desktop.interface 2>/dev/null | grep -q '^accent-color$'; then
                gsettings set org.gnome.desktop.interface accent-color "$accent" 2>/dev/null || true
            fi
        fi
    fi

    # 4. Refresh theme / CSS if helper available
    if command -v aura-glass-apply >/dev/null 2>&1; then
        aura-glass-apply >/dev/null 2>&1 || true
    fi

    # 5. Record active profile
    printf '%s\n' "$id" > "$CONF_DIR/current-profile"

    ok "Profile '$name' applied successfully."
}

cmd_save() {
    local name="${1:-}"
    shift || true
    [ -n "$name" ] || die "missing profile name to save. Usage: aura-glass profile save <name> [--description '...']"

    # Check reserved built-in names
    for row in "${BUILTIN_PROFILES[@]}"; do
        IFS='|' read -r id _ <<< "$row"
        if [ "$id" = "$name" ]; then
            die "cannot overwrite built-in profile '$name'. Please choose a custom name."
        fi
    done

    local desc=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --desc|--description)
                desc="${2:-}"
                shift 2
                ;;
            *)
                desc="$1"
                shift
                ;;
        esac
    done
    [ -n "$desc" ] || desc="Custom user profile saved $(date +'%Y-%m-%d %H:%M')"

    local cur
    cur="$(get_current_state)"
    IFS='|' read -r _ cur_mode cur_radius cur_accent <<< "$cur"

    mkdir -p "$PROFILES_DIR"
    local target_file="$PROFILES_DIR/$name.json"

    python3 -c "
import json
data = {
    'name': '$name',
    'mode': '$cur_mode',
    'radius': '$cur_radius',
    'accent': '$cur_accent',
    'description': '$desc'
}
with open('$target_file', 'w', encoding='utf-8') as f:
    json.dump(data, f, indent=2)
"
    printf '%s\n' "$name" > "$CONF_DIR/current-profile"
    ok "Profile '$name' saved to $target_file."
}

cmd_export() {
    local target="${1:-}"
    local outfile="${2:-}"
    [ -n "$target" ] || die "missing profile name. Usage: aura-glass profile export <name> [file]"

    local prof_info
    prof_info="$(find_profile "$target")" || die "profile '$target' not found."

    IFS='|' read -r _ id name mode radius accent desc <<< "$prof_info"

    local json_content
    json_content="$(python3 -c "
import json
print(json.dumps({
    'name': '$name',
    'mode': '$mode',
    'radius': '$radius',
    'accent': '$accent',
    'description': '$desc'
}, indent=2))
")"

    if [ -n "$outfile" ]; then
        printf '%s\n' "$json_content" > "$outfile"
        ok "Exported profile '$target' to $outfile."
    else
        printf '%s\n' "$json_content"
    fi
}

cmd_import() {
    local infile="${1:-}"
    [ -n "$infile" ] || die "missing input file. Usage: aura-glass profile import <file.json>"
    [ -f "$infile" ] || die "file not found: $infile"

    local p_name
    p_name="$(python3 -c "
import json, sys
try:
    with open('$infile', 'r', encoding='utf-8') as f:
        d = json.load(f)
    print(d.get('name', ''))
except Exception as e:
    sys.exit(1)
")" || die "invalid profile JSON format in $infile"

    [ -n "$p_name" ] || p_name="$(basename "$infile" .json)"

    mkdir -p "$PROFILES_DIR"
    cp -f "$infile" "$PROFILES_DIR/$p_name.json"
    ok "Profile '$p_name' imported successfully."
}

cmd_remove() {
    local target="${1:-}"
    [ -n "$target" ] || die "missing profile name to remove. Usage: aura-glass profile remove <name>"

    for row in "${BUILTIN_PROFILES[@]}"; do
        IFS='|' read -r id _ <<< "$row"
        if [ "$id" = "$target" ]; then
            die "cannot remove built-in profile '$target'."
        fi
    done

    local target_file="$PROFILES_DIR/$target.json"
    if [ -f "$target_file" ]; then
        rm -f "$target_file"
        ok "Removed profile '$target'."
    else
        die "profile '$target' does not exist."
    fi
}

# Main routing
main() {
    local action="${1:-list}"
    shift || true

    case "$action" in
        list) cmd_list "$@" ;;
        apply) cmd_apply "$@" ;;
        save) cmd_save "$@" ;;
        current) cmd_current "$@" ;;
        export) cmd_export "$@" ;;
        import) cmd_import "$@" ;;
        remove|delete|rm) cmd_remove "$@" ;;
        -h|--help|help) usage ;;
        *)
            # If argument matches a profile name directly, apply it
            if find_profile "$action" >/dev/null 2>&1; then
                cmd_apply "$action" "$@"
            else
                die "unknown action '$action'. Run 'aura-glass profile --help' for usage."
            fi
            ;;
    esac
}

main "$@"
