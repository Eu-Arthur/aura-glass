#!/usr/bin/env bash
# aura-glass-flatpak — universal Flatpak sandbox theme synchronization and permission overrides.
set -euo pipefail

CONF_DIR="${AURA_GLASS_CONF:-${AURA_GLASS_DIR:-${TAHOE_GLASS_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/aura-glass}}}"
[ -d "$CONF_DIR" ] || [ ! -d "${XDG_CONFIG_HOME:-$HOME/.config}/tahoe-glass" ] || CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tahoe-glass"

FLATPAK_VAR_DIR="${AURA_GLASS_FLATPAK_VAR:-$HOME/.var/app}"
GTK4_SOURCE="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0/gtk.css"
GTK3_SOURCE="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/gtk.css"

C_BLD=$'\033[1m'
C_CYA=$'\033[1;36m'
C_GRN=$'\033[1;32m'
C_YEL=$'\033[1;33m'
C_RED=$'\033[1;31m'
C_DIM=$'\033[2m'
C_OFF=$'\033[0m'

ok()  { printf '%s✓%s %s\n' "$C_GRN" "$C_OFF" "$*"; }
warn() { printf '%s!%s %s\n' "$C_YEL" "$C_OFF" "$*"; }

usage() {
    cat <<'EOF'
aura-glass-flatpak — universal Flatpak sandbox theme synchronizer

USAGE:
    aura-glass flatpak status
    aura-glass flatpak sync
    aura-glass flatpak override
    aura-glass flatpak revert
    aura-glass flatpak -h | --help

SUBCOMMANDS:
    status      Inspect installed Flatpak applications, permissions, and theme links
    sync        Apply global overrides and inject glass stylesheets into sandboxes
    override    Configure global user filesystem permissions for Flatpak runtimes
    revert      Remove sandbox stylesheet links and revoke theme filesystem overrides
EOF
}

cmd_status() {
    printf '%sFlatpak Sandboxed Applications Glass Status:%s\n\n' "$C_BLD" "$C_OFF"

    local flatpak_installed="${C_RED}not found${C_OFF}"
    if command -v flatpak >/dev/null 2>&1; then
        local fp_ver
        fp_ver="$(flatpak --version 2>/dev/null | awk '{print $2}')"
        flatpak_installed="${C_GRN}installed (${fp_ver:-ready})${C_OFF}"
    fi
    printf '  Flatpak CLI:       %s\n' "$flatpak_installed"
    printf '  Sandbox Root:      %s%s%s\n' "$C_DIM" "$FLATPAK_VAR_DIR" "$C_OFF"

    # Count apps
    local app_count=0
    local themed_count=0

    if [ -d "$FLATPAK_VAR_DIR" ]; then
        for app_dir in "$FLATPAK_VAR_DIR"/*; do
            [ -d "$app_dir" ] || continue
            local app_id="${app_dir##*/}"
            [ "$app_id" != "*" ] || continue
            app_count=$((app_count + 1))

            if [ -L "$app_dir/config/gtk-4.0/gtk.css" ] || [ -f "$app_dir/config/gtk-4.0/gtk.css" ]; then
                themed_count=$((themed_count + 1))
            fi
        done
    fi

    printf '  Installed Apps:    %d detected\n' "$app_count"
    printf '  Themed Sandboxes:  %s%d / %d%s\n\n' "$C_CYA" "$themed_count" "$app_count" "$C_OFF"

    if [ "$app_count" -gt 0 ]; then
        printf '%sDetected Sandboxed Apps:%s\n' "$C_BLD" "$C_OFF"
        for app_dir in "$FLATPAK_VAR_DIR"/*; do
            [ -d "$app_dir" ] || continue
            local app_id="${app_dir##*/}"
            [ "$app_id" != "*" ] || continue
            local status="${C_DIM}not linked${C_OFF}"
            if [ -L "$app_dir/config/gtk-4.0/gtk.css" ] || [ -f "$app_dir/config/gtk-4.0/gtk.css" ]; then
                status="${C_GRN}frosted glass active${C_OFF}"
            fi
            printf '  • %-32s [%s]\n' "$app_id" "$status"
        done
    fi
}

cmd_override() {
    if ! command -v flatpak >/dev/null 2>&1; then
        warn "flatpak command not found. Skipping global runtime override."
        return 0
    fi

    flatpak override --user \
        --filesystem=xdg-config/gtk-4.0:ro \
        --filesystem=xdg-config/gtk-3.0:ro \
        --filesystem=~/.icons:ro \
        --filesystem=xdg-data/icons:ro \
        --env=GTK_THEME=Aura-Glass || return 1

    ok "Applied global Flatpak theme filesystem overrides."
}

# Sandboxed apps can modify these directories. Resolve every directory with
# O_NOFOLLOW, and create backups exclusively so an app cannot plant a link to
# an unrelated host file and have this host-side command overwrite it.
sandbox_styles() {
    python3 - "$1" "$FLATPAK_VAR_DIR" "$GTK4_SOURCE" "$GTK3_SOURCE" <<'PYTHON'
import os
import shutil
import stat
import sys

DIRECTORY = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW

def open_directory(parent, name, create):
    if create:
        try:
            os.mkdir(name, 0o700, dir_fd=parent)
        except FileExistsError:
            pass
    return os.open(name, DIRECTORY, dir_fd=parent)

def sync_style(fd, source):
    if not os.path.isfile(source):
        return
    try:
        current = os.stat('gtk.css', dir_fd=fd, follow_symlinks=False)
    except FileNotFoundError:
        current = None
    if current is not None and stat.S_ISREG(current.st_mode):
        original = os.open('gtk.css', os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)
        with os.fdopen(original, 'rb') as src:
            if not stat.S_ISREG(os.fstat(src.fileno()).st_mode):
                raise ValueError('stylesheet is not a regular file')
            # Preserve the first backup. Never follow an existing backup link.
            try:
                backup = os.open('gtk.css.aurabackup', os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                                 0o600, dir_fd=fd)
            except FileExistsError:
                if not stat.S_ISREG(os.stat('gtk.css.aurabackup', dir_fd=fd, follow_symlinks=False).st_mode):
                    raise ValueError('unsafe stylesheet backup')
            else:
                with os.fdopen(backup, 'wb') as dst:
                    shutil.copyfileobj(src, dst)
    name = '.aura-link-' + os.urandom(16).hex()
    os.symlink(source, name, dir_fd=fd)
    try:
        os.replace(name, 'gtk.css', src_dir_fd=fd, dst_dir_fd=fd)
    finally:
        try:
            os.unlink(name, dir_fd=fd)
        except FileNotFoundError:
            pass

def revert_style(fd, source):
    try:
        if os.readlink('gtk.css', dir_fd=fd) != source:
            return
    except (FileNotFoundError, OSError):
        return
    try:
        backup = os.stat('gtk.css.aurabackup', dir_fd=fd, follow_symlinks=False)
    except FileNotFoundError:
        os.unlink('gtk.css', dir_fd=fd)
        return
    if not stat.S_ISREG(backup.st_mode):
        raise ValueError('unsafe stylesheet backup')
    # Rename the directory entry itself; even a concurrent replacement cannot
    # make us write to a link's target outside the sandbox.
    os.replace('gtk.css.aurabackup', 'gtk.css', src_dir_fd=fd, dst_dir_fd=fd)

action, root, gtk4, gtk3 = sys.argv[1:]
count = 0
failed = False
try:
    if action == 'sync':
        os.makedirs(root, mode=0o700, exist_ok=True)
    if not os.path.exists(root):
        sys.exit(0)
    root_fd = os.open(root, DIRECTORY)
    try:
        for app in os.listdir(root_fd):
            try:
                app_fd = open_directory(root_fd, app, False)
                try:
                    config_fd = open_directory(app_fd, 'config', action == 'sync')
                    try:
                        for version, source in (('gtk-4.0', gtk4), ('gtk-3.0', gtk3)):
                            try:
                                fd = open_directory(config_fd, version, action == 'sync')
                            except FileNotFoundError:
                                continue
                            try:
                                (sync_style if action == 'sync' else revert_style)(fd, source)
                            finally:
                                os.close(fd)
                    finally:
                        os.close(config_fd)
                finally:
                    os.close(app_fd)
                count += 1
            except FileNotFoundError:
                continue
            except (OSError, ValueError) as exc:
                print(f'error: cannot safely update {app}: {exc}', file=sys.stderr)
                failed = True
    finally:
        os.close(root_fd)
except (OSError, ValueError) as exc:
    print(f'error: cannot safely open sandbox root: {exc}', file=sys.stderr)
    sys.exit(1)
print(f'Updated theme stylesheets in {count} Flatpak application sandboxes.')
sys.exit(1 if failed else 0)
PYTHON
}

cmd_sync() {
    cmd_override
    sandbox_styles sync
}

cmd_revert() {
    if command -v flatpak >/dev/null 2>&1; then
        # Keep unrelated overrides, especially restrictions set by the user.
        flatpak override --user \
            --nofilesystem=xdg-config/gtk-4.0 \
            --nofilesystem=xdg-config/gtk-3.0 \
            --nofilesystem=~/.icons \
            --nofilesystem=xdg-data/icons \
            --unset-env=GTK_THEME || return 1
    fi
    sandbox_styles revert
    ok "Revoked Flatpak theme access and reverted stylesheet links."
}

main() {
    [ $# -gt 0 ] || { cmd_status; exit 0; }

    case "$1" in
        status)
            cmd_status
            ;;
        sync|apply)
            cmd_sync
            ;;
        override)
            cmd_override
            ;;
        revert|reset)
            cmd_revert
            ;;
        -h|--help|help)
            usage
            ;;
        *)
            printf 'error: unknown command "%s"\n\n' "$1" >&2
            usage >&2
            exit 1
            ;;
    esac
}

main "$@"
