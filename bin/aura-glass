#!/usr/bin/env bash
# aura-glass — unified CLI controller and status dashboard.
#
# Provides a clean, modern single-entrypoint interface to all aura-glass tools:
#   aura-glass status          Show visual status dashboard
#   aura-glass mode [cmd]      Query or change glass transparency mode
#   aura-glass doctor          System health checks and diagnostics
#   aura-glass settings        Launch graphical settings window
#   aura-glass backup [cmd]    Create, restore, or manage configuration backups
#   aura-glass apply           Re-splice CSS stylesheets and re-read config
#   aura-glass gdm [sync]      Sync wallpaper and monitors to GDM login screen
#   aura-glass update          Check for updates
#   aura-glass ext [cmd]       Manage GNOME Shell extensions
set -euo pipefail

REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
BIN_DIR="$REPO_ROOT/bin"
CONF_DIR="${AURA_GLASS_CONF:-$HOME/.config/aura-glass}"
[ -d "$CONF_DIR" ] || [ ! -d "$HOME/.config/tahoe-glass" ] || CONF_DIR="$HOME/.config/tahoe-glass"

# Terminal styling
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_BLD=$'\033[1m'
    C_DIM=$'\033[2m'
    C_CYA=$'\033[1;36m'
    C_BLU=$'\033[1;34m'
    C_GRN=$'\033[1;32m'
    C_YEL=$'\033[1;33m'
    C_RED=$'\033[1;31m'
    C_MAG=$'\033[1;35m'
    C_OFF=$'\033[0m'
else
    C_BLD='' C_DIM='' C_CYA='' C_BLU='' C_GRN='' C_YEL='' C_RED='' C_MAG='' C_OFF=''
fi

usage() {
    cat <<EOF
${C_BLD}Aura Glass${C_OFF} — macOS / visionOS Frosted Glass Desktop for GNOME

${C_BLD}USAGE:${C_OFF}
    aura-glass <COMMAND> [OPTIONS]

${C_BLD}COMMANDS:${C_OFF}
    ${C_CYA}status${C_OFF}                Display interactive desktop and glass status summary
    ${C_CYA}mode${C_OFF} [get|set|toggle]   Manage glass mode (frosted, transparent, solid, eco, auto)
    ${C_CYA}accent${C_OFF} [auto|set|get]   Manage or auto-sync accent color with wallpaper
    ${C_CYA}shortcut${C_OFF} [enable|status] Configure GNOME keyboard shortcuts (<Super><Alt>G / A)
    ${C_CYA}doctor${C_OFF}                Run full system health checks and diagnostics
    ${C_CYA}settings${C_OFF}              Launch the Libadwaita settings application
    ${C_CYA}backup${C_OFF} [create|restore] Create, restore, export, or import configuration backups
    ${C_CYA}apply${C_OFF}                 Re-splice CSS stylesheets and refresh active theme
    ${C_CYA}gdm${C_OFF} [sync]             Sync desktop wallpaper and primary monitor to GDM
    ${C_CYA}update${C_OFF}                Check for newer aura-glass release
    ${C_CYA}ext${C_OFF} [list|enable]      Inspect and manage companion GNOME Shell extensions
    ${C_CYA}help${C_OFF}, -h, --help       Show this help message
    ${C_CYA}version${C_OFF}, -v          Print version information

${C_BLD}EXAMPLES:${C_OFF}
    aura-glass status
    aura-glass mode toggle
    aura-glass accent auto
    aura-glass shortcut enable
    aura-glass doctor --json
    aura-glass backup create
EOF
}

cmd_version() {
    local ver="unknown"
    if [ -d "$REPO_ROOT/.git" ]; then
        ver="$(git -C "$REPO_ROOT" describe --tags --always 2>/dev/null || echo "git")"
    elif [ -f "$REPO_ROOT/VERSION" ]; then
        ver="$(cat "$REPO_ROOT/VERSION" 2>/dev/null || echo "release")"
    fi
    if [ "$ver" != "unknown" ] && [ "$ver" != "release" ] && [[ ! "$ver" =~ ^v ]]; then
        ver="v$ver"
    fi
    printf 'aura-glass %s\n' "$ver"
}

cmd_status() {
    local ver
    ver="$(git -C "$REPO_ROOT" describe --tags --always 2>/dev/null || echo "v0.1.7")"

    # 1. Mode
    local mode="frosted"
    if [ -f "$CONF_DIR/styling-off" ]; then
        mode="solid"
    elif [ -r "$CONF_DIR/glass-mode" ]; then
        mode="$(head -n 1 "$CONF_DIR/glass-mode" 2>/dev/null || echo "frosted")"
    fi

    local mode_label="$mode"
    case "$mode" in
        frosted)     mode_label="${C_CYA}Frosted Glass${C_OFF} (full blur shaders)" ;;
        transparent) mode_label="${C_BLU}Transparent${C_OFF} (translucent, no blur)" ;;
        solid)       mode_label="${C_DIM}Solid Mode${C_OFF} (opaque surfaces)" ;;
    esac

    # 2. Theme & Accent
    local theme="Aura-Glass"
    if command -v gsettings >/dev/null 2>&1; then
        local user_theme
        user_theme="$(gsettings get org.gnome.shell.extensions.user-theme name 2>/dev/null || true)"
        user_theme="${user_theme//\'/}"
        [ -n "$user_theme" ] && theme="$user_theme"
    fi

    local accent="Default"
    if [ -r "$CONF_DIR/accent" ]; then
        accent="$(head -n 1 "$CONF_DIR/accent" 2>/dev/null || echo "Default")"
    fi

    # 3. Power & Battery
    local power_info="AC Connected"
    if [ -d /sys/class/power_supply ]; then
        for ps in /sys/class/power_supply/*; do
            if [ -f "$ps/type" ] && [ "$(cat "$ps/type" 2>/dev/null)" = "Battery" ]; then
                if [ -f "$ps/status" ] && [ "$(cat "$ps/status" 2>/dev/null)" = "Discharging" ]; then
                    local cap=""
                    [ -f "$ps/capacity" ] && cap=" ($(cat "$ps/capacity" 2>/dev/null)%)"
                    power_info="${C_YEL}Battery Discharging${C_OFF}${cap}"
                else
                    power_info="${C_GRN}AC Connected / Charging${C_OFF}"
                fi
                break
            fi
        done
    fi

    # Auto-Eco status
    local auto_eco="${C_GRN}enabled${C_OFF}"
    if [ -f "$CONF_DIR/no-auto-eco" ]; then
        auto_eco="${C_DIM}disabled${C_OFF}"
    fi

    # 4. Blur Inhibition Status
    local blur_state="${C_GRN}Active${C_OFF}"
    if [ -f "$CONF_DIR/perf-inhibited" ]; then
        blur_state="${C_YEL}Paused (inhibit active)${C_OFF}"
    elif [ "$mode" = "solid" ]; then
        blur_state="${C_DIM}Inactive (solid mode)${C_OFF}"
    fi

    # 5. GNOME Session
    local session="${XDG_SESSION_TYPE:-unknown}"
    local shell_ver=""
    if command -v gnome-shell >/dev/null 2>&1; then
        shell_ver="$(gnome-shell --version 2>/dev/null | awk '{print $3}')"
    fi

    # Print dashboard card
    printf '\n%s╭────────────────────────────────────────────────╮%s\n' "$C_BLU" "$C_OFF"
    printf '%s│%s   %s✨ Aura Glass Desktop Status%s                  %s│%s\n' "$C_BLU" "$C_OFF" "$C_BLD" "$C_OFF" "$C_BLU" "$C_OFF"
    printf '%s├────────────────────────────────────────────────┤%s\n' "$C_BLU" "$C_OFF"
    printf '%s│%s  Version:      %-35s%s│%s\n' "$C_BLU" "$C_OFF" "$ver" "$C_BLU" "$C_OFF"
    printf '%s│%s  Desktop:      GNOME %-10s (%-18s) %s│%s\n' "$C_BLU" "$C_OFF" "${shell_ver:-?}" "${session}" "$C_BLU" "$C_OFF"
    printf '%s│%s  Glass Mode:   %-44s%s│%s\n' "$C_BLU" "$C_OFF" "$mode_label" "$C_BLU" "$C_OFF"
    printf '%s│%s  Shell Theme:  %-35s%s│%s\n' "$C_BLU" "$C_OFF" "$theme" "$C_BLU" "$C_OFF"
    printf '%s│%s  Accent:       %-35s%s│%s\n' "$C_BLU" "$C_OFF" "$accent" "$C_BLU" "$C_OFF"
    printf '%s│%s  Power Source: %-44s%s│%s\n' "$C_BLU" "$C_OFF" "$power_info" "$C_BLU" "$C_OFF"
    printf '%s│%s  Auto-Eco:     %-44s%s│%s\n' "$C_BLU" "$C_OFF" "$auto_eco" "$C_BLU" "$C_OFF"
    printf '%s│%s  Blur Shaders: %-44s%s│%s\n' "$C_BLU" "$C_OFF" "$blur_state" "$C_BLU" "$C_OFF"
    printf '%s╰────────────────────────────────────────────────╯%s\n\n' "$C_BLU" "$C_OFF"
}

cmd_accent() {
    local action="${1:-get}"
    case "$action" in
        auto)
            shift || true
            local tool="$REPO_ROOT/tools/wallpaper-accent.py"
            if [ -x "$tool" ]; then
                python3 "$tool" --apply "$@"
            else
                printf 'error: wallpaper-accent.py extractor not found\n' >&2
                exit 1
            fi
            ;;
        get|"")
            local current="blue"
            if command -v gsettings >/dev/null 2>&1; then
                current="$(gsettings get org.gnome.desktop.interface accent-color 2>/dev/null || echo "'blue'")"
                current="${current//\'/}"
            elif [ -r "$CONF_DIR/accent" ]; then
                current="$(head -n 1 "$CONF_DIR/accent" 2>/dev/null || echo "blue")"
            fi
            printf '%s\n' "$current"
            ;;
        set)
            shift || true
            local target="${1:-}"
            if [ -z "$target" ]; then
                printf 'error: missing accent name (blue, teal, green, yellow, orange, red, pink, purple, slate)\n' >&2
                exit 1
            fi
            case "$target" in
                blue|teal|green|yellow|orange|red|pink|purple|slate)
                    if command -v gsettings >/dev/null 2>&1; then
                        gsettings set org.gnome.desktop.interface accent-color "$target"
                    fi
                    mkdir -p "$CONF_DIR"
                    printf '%s\n' "$target" > "$CONF_DIR/accent"
                    rm -f "$CONF_DIR/accent-from-wallpaper" 2>/dev/null || true
                    if [ -x "$BIN_DIR/aura-glass-apply" ]; then
                        "$BIN_DIR/aura-glass-apply"
                    fi
                    printf '✓ Accent set to %s\n' "$target"
                    ;;
                *)
                    printf 'error: invalid accent "%s". Valid: blue, teal, green, yellow, orange, red, pink, purple, slate\n' "$target" >&2
                    exit 1
                    ;;
            esac
            ;;
        blue|teal|green|yellow|orange|red|pink|purple|slate)
            cmd_accent set "$action"
            ;;
        list)
            cat <<'EOF'
Available GNOME accent colors:
  • blue     (#3584e4) - Default GNOME blue
  • teal     (#2190a4) - Sea green / cyan
  • green    (#3a944a) - Forest green
  • yellow   (#c88800) - Warm amber
  • orange   (#ed5b00) - Deep orange
  • red      (#e62d42) - Crimson red
  • pink     (#d56199) - Vibrant pink
  • purple   (#9141ac) - Royal purple
  • slate    (#6f8396) - Neutral slate gray
EOF
            ;;
        -h|--help|help)
            cat <<'EOF'
USAGE:
    aura-glass accent [get]
    aura-glass accent auto [--json]
    aura-glass accent set <color>
    aura-glass accent list
EOF
            ;;
        *)
            printf 'error: unknown accent action "%s". Use: get, auto, set <color>, list\n' "$action" >&2
            exit 1
            ;;
    esac
}

cmd_shortcut() {
    local action="${1:-status}"
    local path_toggle="/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/aura-glass-toggle/"
    local path_settings="/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/aura-glass-settings/"
    local schema="org.gnome.settings-daemon.plugins.media-keys.custom-keybinding"

    if ! command -v gsettings >/dev/null 2>&1; then
        printf 'error: gsettings is required to manage shortcuts\n' >&2
        exit 1
    fi

    case "$action" in
        status)
            local current_list
            current_list="$(gsettings get org.gnome.settings-daemon.plugins.media-keys custom-keybindings 2>/dev/null || echo "@as []")"
            printf 'Aura Glass Keyboard Shortcuts:\n'
            if [[ "$current_list" == *"$path_toggle"* ]]; then
                local b_toggle
                b_toggle="$(gsettings get "$schema:$path_toggle" binding 2>/dev/null || echo "''")"
                printf '  ✓ Toggle Glass Mode: %s  (aura-glass mode toggle)\n' "${b_toggle//\'/}"
            else
                printf '  ○ Toggle Glass Mode: not installed (recommended: <Super><Alt>g)\n'
            fi

            if [[ "$current_list" == *"$path_settings"* ]]; then
                local b_set
                b_set="$(gsettings get "$schema:$path_settings" binding 2>/dev/null || echo "''")"
                printf '  ✓ Open Settings:     %s  (aura-glass settings)\n' "${b_set//\'/}"
            else
                printf '  ○ Open Settings:     not installed (recommended: <Super><Alt>a)\n'
            fi
            printf '\nTo install shortcuts: aura-glass shortcut enable\n'
            ;;
        enable|install)
            # 1. Configure toggle shortcut
            gsettings set "$schema:$path_toggle" name "Aura Glass - Toggle Glass Mode"
            gsettings set "$schema:$path_toggle" command "aura-glass mode toggle"
            gsettings set "$schema:$path_toggle" binding "<Super><Alt>g"

            # 2. Configure settings shortcut
            gsettings set "$schema:$path_settings" name "Aura Glass - Settings"
            gsettings set "$schema:$path_settings" command "aura-glass settings"
            gsettings set "$schema:$path_settings" binding "<Super><Alt>a"

            # 3. Add to custom-keybindings list if not present
            local current_list
            current_list="$(gsettings get org.gnome.settings-daemon.plugins.media-keys custom-keybindings 2>/dev/null || echo "[]")"
            local new_list="$current_list"
            if [[ "$new_list" != *"$path_toggle"* ]]; then
                if [ "$new_list" = "@as []" ] || [ "$new_list" = "[]" ] || [ "$new_list" = "@as[]" ]; then
                    new_list="['$path_toggle']"
                else
                    new_list="${new_list%]}, '$path_toggle']"
                fi
            fi
            if [[ "$new_list" != *"$path_settings"* ]]; then
                if [ "$new_list" = "@as []" ] || [ "$new_list" = "[]" ] || [ "$new_list" = "@as[]" ]; then
                    new_list="['$path_settings']"
                else
                    new_list="${new_list%]}, '$path_settings']"
                fi
            fi
            gsettings set org.gnome.settings-daemon.plugins.media-keys custom-keybindings "$new_list"
            printf '✓ Registered keyboard shortcuts in GNOME:\n'
            printf '  • <Super><Alt>G -> Toggle Glass Mode (frosted <-> solid)\n'
            printf '  • <Super><Alt>A -> Open Aura Glass Settings\n'
            ;;
        disable|remove)
            local current_list
            current_list="$(gsettings get org.gnome.settings-daemon.plugins.media-keys custom-keybindings 2>/dev/null || echo "[]")"
            local cleaned_list
            cleaned_list="$(python3 -c "
import ast
raw = '''$current_list'''
if raw.startswith('@as '): raw = raw[4:]
try:
    arr = ast.literal_eval(raw)
except Exception:
    arr = []
arr = [p for p in arr if 'aura-glass' not in p]
print(repr(arr))
" 2>/dev/null || echo "[]")"
            gsettings set org.gnome.settings-daemon.plugins.media-keys custom-keybindings "$cleaned_list"
            gsettings reset-recursively "$schema:$path_toggle" 2>/dev/null || true
            gsettings reset-recursively "$schema:$path_settings" 2>/dev/null || true
            printf '✓ Unregistered Aura Glass keyboard shortcuts\n'
            ;;
        -h|--help|help)
            cat <<'EOF'
USAGE:
    aura-glass shortcut status
    aura-glass shortcut enable
    aura-glass shortcut disable
EOF
            ;;
        *)
            printf 'error: unknown shortcut action "%s". Use: status, enable, disable\n' "$action" >&2
            exit 1
            ;;
    esac
}

# Main dispatcher
main() {
    if [ $# -eq 0 ]; then
        if [ -t 1 ]; then
            cmd_status
            exit 0
        else
            usage
            exit 0
        fi
    fi

    local cmd="$1"; shift

    case "$cmd" in
        status)
            cmd_status "$@"
            ;;
        mode)
            exec "$BIN_DIR/aura-glass-mode" "$@"
            ;;
        accent)
            cmd_accent "$@"
            ;;
        shortcut|shortcuts)
            cmd_shortcut "$@"
            ;;
        doctor)
            exec "$BIN_DIR/aura-glass-doctor" "$@"
            ;;
        settings|gui)
            exec "$BIN_DIR/aura-glass-settings" "$@"
            ;;
        backup)
            exec "$BIN_DIR/aura-glass-backup" "$@"
            ;;
        apply)
            exec "$BIN_DIR/aura-glass-apply" "$@"
            ;;
        gdm|sync-gdm)
            if [ "${1:-}" = "sync" ]; then shift; fi
            exec "$BIN_DIR/aura-glass-gdm-sync" "$@"
            ;;
        update|update-check)
            exec "$BIN_DIR/aura-glass-update-check" "$@"
            ;;
        ext|extensions)
            exec "$BIN_DIR/aura-glass-ext" "$@"
            ;;
        preview)
            exec "$BIN_DIR/aura-glass-preview" "$@"
            ;;
        version|-v|--version)
            cmd_version
            ;;
        help|-h|--help)
            usage
            ;;
        *)
            printf 'error: unknown command "%s"\n\n' "$cmd" >&2
            usage >&2
            exit 1
            ;;
    esac
}

main "$@"
