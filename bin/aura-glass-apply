#!/usr/bin/env bash
# Re-apply the aura-glass CSS on top of the installed theme.
#
# All four targets are generated files: re-running the upstream theme's own
# install.sh overwrites them and drops these changes. Run this afterwards.
# It is idempotent — an existing block is replaced, never stacked.
set -euo pipefail

DIR="${AURA_GLASS_DIR:-${TAHOE_GLASS_DIR:-$HOME/.config/aura-glass}}"
[ -d "$DIR" ] || [ ! -d "$HOME/.config/tahoe-glass" ] || DIR="$HOME/.config/tahoe-glass"
# Resolved against what is on disk, not against the shell's dconf key. An
# install that predates the rename is still wearing Tahoe-Dark and has not been
# through install.sh since, so both names have to work. Directory first
# deliberately: reading dconf here would reach the real user's database even
# when HOME is overridden, which is how the fixtures under tools/ drive this.
THEME="${AURA_GLASS_THEME:-${TAHOE_GLASS_THEME:-}}"
if [ -z "$THEME" ]; then
    if [ -d "$HOME/.themes/Aura-Glass" ]; then THEME="Aura-Glass"
    else THEME="Tahoe-Dark"
    fi
fi

SHELL_CSS="$HOME/.themes/$THEME/gnome-shell/gnome-shell.css"
GTK4_CSS="$HOME/.config/gtk-4.0/gtk.css"
GTK4_DARK_CSS="$HOME/.config/gtk-4.0/gtk-dark.css"
GTK3_CSS="$HOME/.config/gtk-3.0/gtk.css"

# Non-fatal, and the only standing guard against splicing into a theme nobody is
# wearing: if these disagree the shell loads one file while we write another.
if command -v dconf >/dev/null 2>&1; then
    worn="$(dconf read /org/gnome/shell/extensions/user-theme/name 2>/dev/null || true)"
    case "$worn" in
        ""|"''"|"'$THEME'") ;;
        *) printf '    ! shell is wearing %s but applying to %s\n' "$worn" "$THEME" >&2 ;;
    esac
fi

# The GTK3 half of the theme ships as a gresource and is never written here, so
# user CSS is ours alone — create it if it does not exist. It loads at
# GTK_STYLE_PROVIDER_PRIORITY_USER, above the theme, so it wins on merit.
mkdir -p "$HOME/.config/gtk-3.0"
[ -f "$GTK3_CSS" ] || : > "$GTK3_CSS"

# The theme standing down, which is what solid mode is. install.sh writes the
# marker; this is the only thing that reads it, because this is the only thing
# that ever put the block into a target in the first place.
#
# Stripping is not enough on its own for the three theme-generated files: apply
# flattens the theme's own shadow and gradient values in place, so a sheet with
# the block removed is still a flattened sheet. The first branch below —
# restore the .orig backup — is uninstall.sh's restore() rule, for the same
# reason it has it: put back whatever was there before.
#
# The second branch, a file recorded .absent, is where this parts ways with
# restore(): restore() deletes that file outright, because uninstall is a
# one-way door with nowhere for it to go back to. Standing down is not a
# one-way door — solid is a mode like any other, and coming back out of it has
# to be one run of this same script with nothing lost along the way — so the
# file is moved aside into backups/<name>.stood-down instead of deleted: gone
# from where GTK reads it, which is the whole point, but kept for the revive
# step below to put back. A .stood-down left over from an earlier stand-down
# is overwritten, because the file on disk right now is the newer truth.
#
# The third branch, reached with neither record, is where this deliberately
# parts ways with restore() a second time: restore() skips and leaves the
# file untouched, because it is a one-way door and a missing backup means it
# does not know what to put back. Standing down only has to undo what we
# added, which it can always do regardless of the backup record, so it strips
# the block and leaves whatever else is in the file alone rather than leaving
# our styling spliced in. In the supported flow this branch is never actually
# reached — install_theme's backup_once guarantees an .orig or an .absent for
# all four targets before any of this can run — so it exists as a safety net
# for a backups/ directory that has been damaged, not a path the installer
# takes.
if [ -f "$DIR/styling-off" ]; then
    stand_down() {   # stand_down TARGET BACKUP_NAME
        local target="$1" name="$2" bak="$DIR/backups/$2.orig"
        if [ -f "$bak" ]; then
            cp -a "$bak" "$target"
            echo "restored $target"
            return
        fi
        if [ -e "$DIR/backups/$name.absent" ]; then
            if [ -f "$target" ]; then
                mv -f "$target" "$DIR/backups/$name.stood-down"
                echo "moved $target aside (nothing was there before)"
            else
                echo "already stood down: $target"
            fi
            return
        fi
        [ -f "$target" ] || { echo "skip (missing target): $target"; return; }
        python3 - "$target" <<'PY'
import sys, re
target = sys.argv[1]
css = open(target, encoding="utf-8").read()
new = css
for name in ("aura-glass", "tahoe-glass", "tahoe-tweaks"):
    new = re.sub(
        r"/\* >>> %s BEGIN <<< \*/.*?/\* >>> %s END <<< \*/\n?" % (name, name),
        "", new, flags=re.S,
    )
if new != css:
    open(target, "w", encoding="utf-8").write(new)
    print("stripped", target)
else:
    print("no block in", target)
PY
    }
    stand_down "$SHELL_CSS"     "gnome-shell.css"
    stand_down "$GTK4_CSS"      "gtk4-gtk.css"
    stand_down "$GTK4_DARK_CSS" "gtk4-gtk-dark.css"
    stand_down "$GTK3_CSS"      "gtk3-gtk.css"
    echo "the theme has stood down — restart GTK apps to pick up the GTK side"
    exit 0
fi

# The other half of standing down. A target stand_down moved aside has to be
# put back before apply below gets anywhere near it — apply refuses to touch
# a target that does not exist, so without this, coming out of solid mode
# would leave that file gone until something else recreated it. That
# something cannot be left to the upstream theme's own installer: switching
# modes is meant to be one run of this script, not this script plus a full
# theme reinstall just to get back a file this script is the one that moved.
revive() {   # revive TARGET BACKUP_NAME
    local target="$1" name="$2" stood="$DIR/backups/$2.stood-down"
    if [ ! -f "$target" ] && [ -f "$stood" ]; then
        mv -f "$stood" "$target"
        echo "revived $target"
    fi
}
revive "$SHELL_CSS"     "gnome-shell.css"
revive "$GTK4_CSS"      "gtk4-gtk.css"
revive "$GTK4_DARK_CSS" "gtk4-gtk-dark.css"
revive "$GTK3_CSS"      "gtk3-gtk.css"

# apply TARGET FLATTEN SNIPPET... — one marked block per target, concatenating
# every snippet that is actually present. Optional sheets are installed and
# removed by install.sh rather than switched on here, so a missing one simply
# drops out and an older $CONF_DIR with only the original sheets keeps working.
#
# FLATTEN=1 also rewrites the theme's own shadow and gradient values to `none`
# in place. See the note on flattening below; FLATTEN=0 leaves the target's
# existing content untouched and only appends.
apply_batch() {
    local batch_args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --target)
                local target="$2" flatten="$3"; shift 3
                if [ ! -f "$target" ]; then
                    echo "skip (missing target): $target"
                    while [ $# -gt 0 ] && [ "$1" != "--target" ]; do shift; done
                    continue
                fi
                local present=()
                while [ $# -gt 0 ] && [ "$1" != "--target" ]; do
                    [ -f "$1" ] && present+=("$1")
                    shift
                done
                if [ ${#present[@]} -eq 0 ]; then
                    echo "skip (no snippets): $target"
                else
                    batch_args+=(--target "$target" "$flatten" "${present[@]}")
                fi
                ;;
            *) shift ;;
        esac
    done

    [ ${#batch_args[@]} -gt 0 ] || return 0
    python3 - "${batch_args[@]}" <<'PY'
import sys, re

BEGIN = "/* >>> aura-glass BEGIN <<< */"
END   = "/* >>> aura-glass END <<< */"

GRADIENT = re.compile(r"\b(?:repeating-)?(?:linear|radial|conic)-gradient\s*\(")
COLOR = re.compile(r"rgba?\(([^)]*)\)|#([0-9a-fA-F]{3,8})\b")
ACCENT_HEX = re.compile(r"#(?:0091ff|3584e4|3484e2|1c6bc7|619fe8)\b", re.I)

snippets_cache = {}


def read_snippet(path):
    if path not in snippets_cache:
        snippets_cache[path] = open(path, encoding="utf-8").read().rstrip("\n")
    return snippets_cache[path]


def parse_color(m):
    if m.group(2):
        h = m.group(2)
        if len(h) in (3, 4):
            h = "".join(c * 2 for c in h)
        if len(h) not in (6, 8):
            return None
        v = [int(h[i:i + 2], 16) for i in range(0, len(h), 2)]
        return (v[0], v[1], v[2], v[3] / 255 if len(v) == 4 else 1.0)
    parts = [p.strip() for p in m.group(1).replace("/", ",").split(",") if p.strip()]
    if len(parts) < 3:
        return None
    try:
        rgb = [float(p.rstrip("%")) for p in parts[:3]]
        a = float(parts[3].rstrip("%")) if len(parts) > 3 else 1.0
    except ValueError:
        return None
    return (rgb[0], rgb[1], rgb[2], a)


def average(value):
    """The flat equivalent of a gradient: the mean of its colour stops."""
    stops = [parse_color(m) for m in COLOR.finditer(value)]
    if not stops or any(s is None for s in stops):
        return None
    k = len(stops)
    r, g, b = (sum(s[i] for s in stops) / k for i in range(3))
    a = sum(s[3] for s in stops) / k
    return "rgba(%d, %d, %d, %s)" % (round(r), round(g), round(b),
                                     ("%.3f" % a).rstrip("0").rstrip("."))


def is_transparent(value):
    value = value.strip()
    if not value or value == "transparent":
        return True
    c = COLOR.match(value)
    return c is not None and parse_color(c) is not None and parse_color(c)[3] == 0


def process_target(target, flatten, snippets):
    css = open(target, encoding="utf-8").read()
    for name in ("aura-glass", "tahoe-glass", "tahoe-tweaks"):
        css = re.sub(
            r"/\* >>> %s BEGIN <<< \*/.*?/\* >>> %s END <<< \*/\n?" % (name, name),
            "", css, flags=re.S,
        )

    if flatten:
        n = [0, 0, 0]

        def shadow(m):
            prop, val = m.group(1), m.group(2)
            if val.strip() == "none":
                return m.group(0)
            n[0] += 1
            return "%s: none" % prop

        def body(m):
            decls = m.group(1)
            decls = re.sub(r"\b(box-shadow|text-shadow)\s*:\s*([^;}]*)", shadow, decls)

            img = re.search(r"\bbackground-image\s*:\s*([^;}]*)", decls)
            if img and GRADIENT.search(img.group(1)):
                colours = re.findall(r"\bbackground-color\s*:\s*([^;}]*)", decls)
                if not colours or is_transparent(colours[-1]):
                    flat = average(img.group(1))
                    if flat:
                        n[2] += 1
                        if colours:
                            decls = re.sub(
                                r"\bbackground-color\s*:\s*([^;}]*)",
                                lambda c: ("background-color: " + flat
                                           if is_transparent(c.group(1)) else c.group(0)),
                                decls,
                            )
                        else:
                            decls = decls.replace(
                                img.group(0), "background-color: %s; %s" % (flat, img.group(0)), 1)
                n[1] += 1
                decls = re.sub(r"\bbackground-image\s*:\s*([^;}]*)",
                               lambda i: ("background-image: none"
                                          if GRADIENT.search(i.group(1)) else i.group(0)),
                               decls)
            return "{%s}" % decls

        css = re.sub(r"\{([^{}]*)\}", body, css)
        print("flattened -> %s (%d shadow%s, %d gradient%s, %d ground%s kept)"
              % (target, n[0], "" if n[0] == 1 else "s", n[1], "" if n[1] == 1 else "s",
                 n[2], "" if n[2] == 1 else "s"))

    accent = ("-st-accent-color" if "gnome-shell" in target else
              "@accent_bg_color" if "gtk-4.0" in target else None)
    if accent:
        selfref = (re.compile(r"^\s*@define-color\s+" + re.escape(accent[1:]) + r"\b")
                   if accent.startswith("@") else None)
        css = "".join(
            line if (selfref and selfref.match(line)) else ACCENT_HEX.sub(accent, line)
            for line in css.splitlines(True)
        )

    block = "\n\n".join(read_snippet(p) for p in snippets)
    open(target, "w", encoding="utf-8").write(
        css.rstrip("\n") + "\n\n" + BEGIN + "\n" + block + "\n" + END + "\n"
    )
    print("applied ->", target, "(%d snippet%s)" % (len(snippets), "" if len(snippets) == 1 else "s"))


groups = []
cur = None
for arg in sys.argv[1:]:
    if arg == "--target":
        if cur:
            groups.append(cur)
        cur = []
    elif cur is not None:
        cur.append(arg)
if cur:
    groups.append(cur)

for g in groups:
    if len(g) >= 2:
        process_target(g[0], g[1] == "1", g[2:])
PY
}

_APPLY_QUEUE=()
apply() {
    _APPLY_QUEUE+=(--target "$@")
}
flush_apply() {
    [ ${#_APPLY_QUEUE[@]} -gt 0 ] || return 0
    apply_batch "${_APPLY_QUEUE[@]}"
    _APPLY_QUEUE=()
}

# Snippet order is the cascade. These sheets override each other on equal
# specificity in several places by design — the dropdown radius is meant to beat
# the button radius it follows, the accent slider fill is meant to beat the
# white one, and the second .quick-settings .icon-button block is meant to beat
# the first — so the numeric prefixes are load-bearing, not decoration. Keep
# each list sorted by prefix, and put anything new at the position its cascade
# needs rather than at the end.
#
# A file that is absent drops out silently (see apply), which is how the two
# optional sheets plug in and out. The monolithic shell-tweaks.css and
# gtk4-tweaks.css these replaced are deliberately not listed: install_css
# deletes them from $CONF_DIR on upgrade, because a $CONF_DIR holding both the
# monolith and its parts would apply every rule twice.
SHELL_SNIPPETS=(
    "$DIR/shell-00-flat.css"
    "$DIR/shell-10-quick-settings.css"
    "$DIR/shell-20-popup-menus.css"
    "$DIR/shell-30-notifications.css"
    "$DIR/shell-40-quick-toggles.css"
    "$DIR/shell-50-dialogs.css"
    "$DIR/shell-80-solid.css"
    "$DIR/shell-90-density.css"
    "$DIR/shell-popup-blur.css"
    "$DIR/shell-notification-blur.css"
)
GTK4_SNIPPETS=(
    "$DIR/gtk4-00-flat.css"
    "$DIR/gtk4-10-fields.css"
    "$DIR/gtk4-20-buttons.css"
    "$DIR/gtk4-30-dropdowns.css"
    "$DIR/gtk4-40-containers.css"
    "$DIR/gtk4-50-window-controls.css"
    "$DIR/gtk4-60-controls.css"
    "$DIR/gtk4-70-surfaces.css"
    "$DIR/gtk4-transparency.css"
    "$DIR/gtk4-window-controls-adwaita.css"
    "$DIR/gtk4-window-controls-material.css"
    "$DIR/gtk4-window-controls-flat.css"
)

# The three theme-generated targets are flattened. Re-running is safe: a value
# already rewritten to `none` is left alone, so the second run reports zero.
apply "$SHELL_CSS"     1 "${SHELL_SNIPPETS[@]}"
apply "$GTK4_CSS"      1 "${GTK4_SNIPPETS[@]}"
apply "$GTK4_DARK_CSS" 1 "${GTK4_SNIPPETS[@]}"
# GTK3's half of the theme ships as a gresource, so there is nothing here to
# flatten — gtk3-tweaks.css resets it with `*` instead, which works because user
# CSS loads at GTK_STYLE_PROVIDER_PRIORITY_USER, above the theme. Flattening is
# off for a second reason too: unlike the other three this file is not
# theme-generated, so anything already in it is the user's own and stays as is.
apply "$GTK3_CSS"      0 "$DIR/gtk3-tweaks.css" \
                         "$DIR/gtk3-window-controls-adwaita.css" \
                         "$DIR/gtk3-window-controls-material.css" \
                         "$DIR/gtk3-window-controls-flat.css"
flush_apply

# The User Themes extension reloads on a settings change, not on a file change,
# so toggle the key to force Main.loadTheme().
SD="$HOME/.local/share/gnome-shell/extensions/user-theme@gnome-shell-extensions.gcampax.github.com/schemas"
[ -d "$SD" ] || SD="/usr/share/gnome-shell/extensions/user-theme@gnome-shell-extensions.gcampax.github.com/schemas"
if [ -d "$SD" ]; then
    cur=$(GSETTINGS_SCHEMA_DIR="$SD" gsettings get org.gnome.shell.extensions.user-theme name 2>/dev/null || echo "''")
    cur=${cur#\'}; cur=${cur%\'}
    if [ -n "$cur" ]; then
        GSETTINGS_SCHEMA_DIR="$SD" gsettings set org.gnome.shell.extensions.user-theme name ''
        sleep 0.15
        GSETTINGS_SCHEMA_DIR="$SD" gsettings set org.gnome.shell.extensions.user-theme name "$cur"
        echo "shell theme reloaded ($cur)"
    fi
fi

# GTK apps read their CSS at startup, so already-running apps keep the old look
# until they are restarted. Nothing to do about that from here.
echo "done — restart GTK apps to pick up the GTK side"
