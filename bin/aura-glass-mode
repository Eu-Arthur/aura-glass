#!/usr/bin/env bash
# aura-glass-mode — instant glass mode query, switch, and toggle utility.
set -euo pipefail

CONF_DIR="${AURA_GLASS_DIR:-${TAHOE_GLASS_DIR:-$HOME/.config/aura-glass}}"
[ -d "$CONF_DIR" ] || [ ! -d "$HOME/.config/tahoe-glass" ] || CONF_DIR="$HOME/.config/tahoe-glass"

# Guard: Refuse running as root
if [ "$(id -u)" -eq 0 ]; then
    printf 'error: aura-glass-mode manages user desktop styling and must not be run as root.\n' >&2
    exit 1
fi

usage() {
    cat <<'EOF'
aura-glass-mode — glass transparency mode controller

USAGE:
    aura-glass-mode [get]
    aura-glass-mode set <frosted | transparent | solid>
    aura-glass-mode <frosted | transparent | solid>
    aura-glass-mode toggle
    aura-glass-mode eco [on | off]
    aura-glass-mode -h | --help

OPTIONS:
    --notify       Send a desktop notification on mode change
    -h, --help     Show this help message

MODES:
    frosted        Blur behind windows and popups (standard macOS/visionOS look)
    transparent    Translucent windows without background blur (lighter on GPU)
    solid          Opaque styling with no transparency or blur
    eco            Battery saving preset (transparent windows + clipped redraws)
EOF
}

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
ok()  { printf '✓ %s\n' "$*"; }

get_current_mode() {
    if [ -f "$CONF_DIR/styling-off" ]; then
        echo "solid"
        return 0
    fi

    if [ -r "$CONF_DIR/glass-mode" ]; then
        local m
        m="$(head -n 1 "$CONF_DIR/glass-mode" 2>/dev/null || true)"
        case "$m" in
            frosted|transparent|solid)
                echo "$m"
                return 0
                ;;
        esac
    fi

    echo "frosted"
}

dispatch_notification() {
    local mode="$1"
    if command -v notify-send >/dev/null 2>&1; then
        local title="Aura Glass"
        local body="Mode switched to ${mode^}"
        notify-send -i preferences-desktop-theme -a "Aura Glass" "$title" "$body" 2>/dev/null || true
    fi
}

set_mode() {
    local target="$1"
    local do_notify="${2:-0}"

    case "$target" in
        frosted|transparent|solid) ;;
        *) die "unknown glass mode '$target' (choose frosted, transparent, or solid)" ;;
    esac

    local repo_root
    repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    local installer=""

    if [ -x "$repo_root/install.sh" ]; then
        installer="$repo_root/install.sh"
    elif [ -x "$HOME/.local/share/aura-glass/install.sh" ]; then
        installer="$HOME/.local/share/aura-glass/install.sh"
    fi

    # Check if a full install exists to run install.sh --settings-only
    local has_installed_theme=0
    if [ -d "$HOME/.themes/Aura-Glass" ] || [ -d "$HOME/.themes/Tahoe-Dark" ]; then
        has_installed_theme=1
    fi

    if [ -n "$installer" ] && [ "$has_installed_theme" = 1 ]; then
        "$installer" --settings-only --glass-mode "$target"
    else
        # Standalone / direct state transition
        mkdir -p "$CONF_DIR"
        chmod 700 "$CONF_DIR"
        printf '%s\n' "$target" > "$CONF_DIR/glass-mode"
        chmod 600 "$CONF_DIR/glass-mode" 2>/dev/null || true

        if [ "$target" = "solid" ]; then
            touch "$CONF_DIR/styling-off"
        else
            rm -f "$CONF_DIR/styling-off"
        fi

        # Find aura-glass-apply
        local apply_bin=""
        if [ -x "$repo_root/bin/aura-glass-apply" ]; then
            apply_bin="$repo_root/bin/aura-glass-apply"
        elif command -v aura-glass-apply >/dev/null 2>&1; then
            apply_bin="aura-glass-apply"
        elif [ -x "$HOME/.local/bin/aura-glass-apply" ]; then
            apply_bin="$HOME/.local/bin/aura-glass-apply"
        fi

        if [ -n "$apply_bin" ]; then
            "$apply_bin" || true
        fi
    fi

    if [ "$do_notify" = 1 ]; then
        dispatch_notification "$target"
    fi

    ok "glass mode set to: $target"
}

toggle_mode() {
    local do_notify="${1:-0}"
    local current
    current="$(get_current_mode)"
    local next

    case "$current" in
        frosted)     next="transparent" ;;
        transparent) next="solid" ;;
        solid)       next="frosted" ;;
        *)           next="frosted" ;;
    esac

    set_mode "$next" "$do_notify"
}

set_eco() {
    local state="${1:-on}"
    local do_notify="${2:-0}"
    case "$state" in
        on|1|true)
            set_mode "transparent" "$do_notify"
            if command -v dconf >/dev/null 2>&1; then
                dconf write /org/gnome/shell/extensions/blur-my-shell/hacks-level 1 2>/dev/null || true
            fi
            ok "eco mode enabled (transparent windows + clipped redraws)"
            ;;
        off|0|false)
            set_mode "frosted" "$do_notify"
            if command -v dconf >/dev/null 2>&1; then
                dconf write /org/gnome/shell/extensions/blur-my-shell/hacks-level 2 2>/dev/null || true
            fi
            ok "eco mode disabled (frosted glass restored)"
            ;;
        *)
            die "unknown eco state '$state' (choose 'on' or 'off')"
            ;;
    esac
}

# Parse flags and arguments
NOTIFY=0
ARGS=()

for arg in "$@"; do
    case "$arg" in
        --notify) NOTIFY=1 ;;
        -h|--help|help) usage; exit 0 ;;
        *) ARGS+=("$arg") ;;
    esac
done

if [ "${#ARGS[@]}" -eq 0 ]; then
    get_current_mode
    exit 0
fi

subcmd="${ARGS[0]}"

case "$subcmd" in
    get)
        get_current_mode
        ;;
    set)
        [ "${#ARGS[@]}" -ge 2 ] || die "set requires a mode (frosted, transparent, or solid)"
        set_mode "${ARGS[1]}" "$NOTIFY"
        ;;
    toggle)
        toggle_mode "$NOTIFY"
        ;;
    eco)
        state="${ARGS[1]:-on}"
        set_eco "$state" "$NOTIFY"
        ;;
    frosted|transparent|solid)
        set_mode "$subcmd" "$NOTIFY"
        ;;
    *)
        die "unknown command or mode '$subcmd'. Run 'aura-glass-mode --help' for usage."
        ;;
esac
