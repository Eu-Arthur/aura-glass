#!/usr/bin/env bash
# aura-glass-daemon — unified event-driven background service for Aura Glass.
set -euo pipefail

CONF_DIR="${AURA_GLASS_CONF:-${AURA_GLASS_DIR:-${TAHOE_GLASS_DIR:-$HOME/.config/aura-glass}}}"
[ -d "$CONF_DIR" ] || [ ! -d "$HOME/.config/tahoe-glass" ] || CONF_DIR="$HOME/.config/tahoe-glass"

PID_FILE="$CONF_DIR/daemon.pid"
LOG_FILE="$CONF_DIR/daemon.log"
SYSTEMD_USER_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
SERVICE_FILE="$SYSTEMD_USER_DIR/aura-glass.service"

# Guard: Refuse running as root
if [ "$(id -u)" -eq 0 ]; then
    printf 'error: aura-glass-daemon must not be run as root.\n' >&2
    exit 1
fi

C_BLD=$'\033[1m'
C_BLU=$'\033[1;34m'
C_CYA=$'\033[1;36m'
C_GRN=$'\033[1;32m'
C_YEL=$'\033[1;33m'
C_RED=$'\033[1;31m'
C_DIM=$'\033[2m'
C_OFF=$'\033[0m'

usage() {
    cat <<'EOF'
aura-glass-daemon — unified background event monitor & systemd service

USAGE:
    aura-glass daemon status
    aura-glass daemon start
    aura-glass daemon stop
    aura-glass daemon restart
    aura-glass daemon run
    aura-glass daemon logs [-n lines]
    aura-glass daemon install-service [--enable]
    aura-glass daemon uninstall-service
    aura-glass daemon -h | --help

FEATURES:
    • Wallpaper Accent Auto-Sync: Updates accent color instantly when wallpaper changes
    • Color-Scheme Watcher: Synchronizes icons & stylesheets on Dark/Light mode toggle
    • Battery Auto-Eco Watcher: Automatically pauses GPU blur when discharging on battery
    • Event-driven: 0% CPU consumption when idle (no polling loops)
EOF
}

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
ok()  { printf '✓ %s\n' "$*"; }
log() { printf '[%s] %s\n' "$(date +'%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE" 2>/dev/null || true; }

is_running() {
    if [ -f "$PID_FILE" ]; then
        local pid
        pid="$(head -n 1 "$PID_FILE" 2>/dev/null || true)"
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

cmd_status() {
    printf '%sAura Glass Background Daemon:%s\n' "$C_BLD" "$C_OFF"
    
    # 1. Process status
    if is_running; then
        local pid
        pid="$(cat "$PID_FILE")"
        printf '  Status:        %sActive (running, PID %s)%s\n' "$C_GRN" "$pid" "$C_OFF"
    else
        printf '  Status:        %sInactive (stopped)%s\n' "$C_DIM" "$C_OFF"
    fi

    # 2. Systemd user service status
    if command -v systemctl >/dev/null 2>&1; then
        local is_enabled is_active
        is_enabled="$(systemctl --user is-enabled aura-glass.service 2>/dev/null || echo "not-installed")"
        is_active="$(systemctl --user is-active aura-glass.service 2>/dev/null || echo "inactive")"
        is_enabled="$(echo "$is_enabled" | head -n 1)"
        is_active="$(echo "$is_active" | head -n 1)"
        printf '  Systemd Unit:  %s (%s)\n' "$is_active" "$is_enabled"
    fi

    # 3. Monitored capabilities
    printf '\n%sActive Capabilities:%s\n' "$C_BLD" "$C_OFF"
    
    # Wallpaper monitor
    if [ -f "$CONF_DIR/no-wallpaper-accent" ]; then
        printf '  ○ Wallpaper Accent:   %sdisabled (%s/no-wallpaper-accent)%s\n' "$C_DIM" "$CONF_DIR" "$C_OFF"
    else
        printf '  ● Wallpaper Accent:   %sreactive (D-Bus / GSettings)%s\n' "$C_GRN" "$C_OFF"
    fi

    # Auto-Eco battery
    if [ -f "$CONF_DIR/no-auto-eco" ]; then
        printf '  ○ Battery Auto-Eco:   %sdisabled (%s/no-auto-eco)%s\n' "$C_DIM" "$CONF_DIR" "$C_OFF"
    else
        printf '  ● Battery Auto-Eco:   %senabled (dynamic UPower / sysfs)%s\n' "$C_GRN" "$C_OFF"
    fi

    # Circadian Adaptive
    if [ -f "$CONF_DIR/adaptive-mode" ]; then
        printf '  ● Circadian Adaptive: %senabled (Night Light / solar sync)%s\n' "$C_GRN" "$C_OFF"
    else
        printf '  ○ Circadian Adaptive: %sdisabled (%s/adaptive-mode)%s\n' "$C_DIM" "$CONF_DIR" "$C_OFF"
    fi

    # Log file
    if [ -f "$LOG_FILE" ]; then
        local log_size
        log_size="$(du -h "$LOG_FILE" 2>/dev/null | awk '{print $1}')"
        printf '  Log File:             %s (%s)\n' "$LOG_FILE" "${log_size:-0B}"
    fi
}

cmd_logs() {
    local lines=25
    while [ $# -gt 0 ]; do
        case "$1" in
            -n|--lines)
                lines="${2:-25}"
                shift 2
                ;;
            *) shift ;;
        esac
    done

    if [ -f "$LOG_FILE" ]; then
        tail -n "$lines" "$LOG_FILE"
    else
        printf 'No log entries found (%s does not exist yet).\n' "$LOG_FILE"
    fi
}

cmd_start() {
    if is_running; then
        local pid
        pid="$(cat "$PID_FILE")"
        printf 'aura-glass-daemon is already running (PID %s).\n' "$pid"
        return 0
    fi

    mkdir -p "$CONF_DIR"
    nohup "$0" run >> "$LOG_FILE" 2>&1 &
    local new_pid=$!
    printf '%s\n' "$new_pid" > "$PID_FILE"
    sleep 0.2

    if kill -0 "$new_pid" 2>/dev/null; then
        ok "Started aura-glass-daemon (PID $new_pid)."
    else
        die "Failed to start aura-glass-daemon. Check logs with 'aura-glass daemon logs'."
    fi
}

cmd_stop() {
    if ! is_running; then
        printf 'aura-glass-daemon is not running.\n'
        rm -f "$PID_FILE"
        return 0
    fi

    local pid
    pid="$(cat "$PID_FILE")"
    printf 'Stopping aura-glass-daemon (PID %s)... ' "$pid"
    kill "$pid" 2>/dev/null || true

    local count=0
    while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 15 ]; do
        sleep 0.2
        count=$((count + 1))
    done

    if kill -0 "$pid" 2>/dev/null; then
        kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
    printf '%s[ OK ]%s\n' "$C_GRN" "$C_OFF"
}

cmd_restart() {
    cmd_stop
    cmd_start
}

cmd_install_service() {
    local enable_now=0
    for arg in "$@"; do
        [ "$arg" = "--enable" ] || [ "$arg" = "--now" ] && enable_now=1
    done

    mkdir -p "$SYSTEMD_USER_DIR"
    local bin_path
    bin_path="$(command -v aura-glass-daemon 2>/dev/null || true)"
    [ -n "$bin_path" ] || bin_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/aura-glass-daemon"

    cat > "$SERVICE_FILE" <<EOF
[Unit]
Description=Aura Glass Background Desktop & Accent Monitor
Documentation=https://github.com/Eu-Arthur/aura-glass
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=$bin_path run
Restart=on-failure
RestartSec=5s
Environment=PATH=$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=graphical-session.target
EOF

    ok "Generated user service file at $SERVICE_FILE"

    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user daemon-reload 2>/dev/null || true
        if [ "$enable_now" -eq 1 ]; then
            systemctl --user enable --now aura-glass.service 2>/dev/null || true
            ok "Enabled and started aura-glass.service."
        else
            printf '%sTo enable automatically on login, run:%s\n' "$C_DIM" "$C_OFF"
            printf '  systemctl --user enable --now aura-glass.service\n'
        fi
    fi
}

cmd_uninstall_service() {
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user disable --now aura-glass.service 2>/dev/null || true
    fi
    if [ -f "$SERVICE_FILE" ]; then
        rm -f "$SERVICE_FILE"
        ok "Removed $SERVICE_FILE."
    fi
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user daemon-reload 2>/dev/null || true
    fi
}

# The foreground event loop
cmd_run() {
    mkdir -p "$CONF_DIR"
    printf '%s\n' "$$" > "$PID_FILE"
    log "aura-glass-daemon started (PID $$)"

    local subpids=()

    cleanup() {
        log "aura-glass-daemon shutting down..."
        for p in "${subpids[@]}"; do
            kill "$p" 2>/dev/null || true
        done
        rm -f "$PID_FILE"
        exit 0
    }
    trap cleanup SIGINT SIGTERM SIGHUP EXIT

    # 1. Background Wallpaper Watcher (if gsettings available)
    if command -v gsettings >/dev/null 2>&1 && gsettings list-schemas 2>/dev/null | grep -q '^org\.gnome\.desktop\.background$'; then
        (
            # Monitor wallpaper changes
            gsettings monitor org.gnome.desktop.background picture-uri 2>/dev/null | while read -r _; do
                if [ ! -f "$CONF_DIR/no-wallpaper-accent" ]; then
                    sleep 0.8
                    if command -v aura-glass >/dev/null 2>&1; then
                        aura-glass accent auto >/dev/null 2>&1 || true
                    fi
                fi
            done
        ) &
        subpids+=("$!")

        (
            gsettings monitor org.gnome.desktop.background picture-uri-dark 2>/dev/null | while read -r _; do
                if [ ! -f "$CONF_DIR/no-wallpaper-accent" ]; then
                    sleep 0.8
                    if command -v aura-glass >/dev/null 2>&1; then
                        aura-glass accent auto >/dev/null 2>&1 || true
                    fi
                fi
            done
        ) &
        subpids+=("$!")
    fi

    # 2. Interface Color-Scheme Watcher (Light/Dark mode)
    if command -v gsettings >/dev/null 2>&1 && gsettings list-schemas 2>/dev/null | grep -q '^org\.gnome\.desktop\.interface$'; then
        (
            gsettings monitor org.gnome.desktop.interface color-scheme 2>/dev/null | while read -r _; do
                sleep 0.5
                if command -v aura-glass-icon-sync >/dev/null 2>&1; then
                    aura-glass-icon-sync apply >/dev/null 2>&1 || true
                fi
            done
        ) &
        subpids+=("$!")
    fi

    # 3. Battery Watcher loop (gentle 30s check for power supply state)
    (
        local last_state="unknown"
        while true; do
            if [ ! -f "$CONF_DIR/no-auto-eco" ] && [ -d /sys/class/power_supply ]; then
                local on_battery=0
                for ps in /sys/class/power_supply/*; do
                    if [ -f "$ps/type" ] && [ "$(cat "$ps/type" 2>/dev/null)" = "Battery" ]; then
                        if [ -f "$ps/status" ] && [ "$(cat "$ps/status" 2>/dev/null)" = "Discharging" ]; then
                            on_battery=1
                            break
                        fi
                    fi
                done

                if [ "$on_battery" -eq 1 ] && [ "$last_state" != "discharging" ]; then
                    last_state="discharging"
                    log "Battery discharging detected: enabling auto-eco"
                    if command -v aura-glass-mode >/dev/null 2>&1; then
                        aura-glass-mode eco on >/dev/null 2>&1 || true
                    fi
                elif [ "$on_battery" -eq 0 ] && [ "$last_state" = "discharging" ]; then
                    last_state="ac"
                    log "AC power restored: disabling auto-eco"
                    if command -v aura-glass-mode >/dev/null 2>&1; then
                        aura-glass-mode eco off >/dev/null 2>&1 || true
                    fi
                fi
            fi
            sleep 30
        done
    ) &
    subpids+=("$!")

    # 4. Circadian & Night Light Watcher
    if command -v gsettings >/dev/null 2>&1 && gsettings list-schemas 2>/dev/null | grep -q '^org\.gnome\.settings-daemon\.plugins\.color$'; then
        (
            gsettings monitor org.gnome.settings-daemon.plugins.color night-light-active 2>/dev/null | while read -r _; do
                if [ -f "$CONF_DIR/adaptive-mode" ]; then
                    sleep 1.0
                    if command -v aura-glass-adaptive >/dev/null 2>&1; then
                        aura-glass-adaptive sync >/dev/null 2>&1 || true
                    fi
                fi
            done
        ) &
        subpids+=("$!")
    fi

    # Wait for any child
    wait -n "${subpids[@]}" 2>/dev/null || wait
}

# Main routing
main() {
    local action="${1:-status}"
    shift || true

    case "$action" in
        status) cmd_status "$@" ;;
        start) cmd_start "$@" ;;
        stop) cmd_stop "$@" ;;
        restart) cmd_restart "$@" ;;
        run) cmd_run "$@" ;;
        logs|log) cmd_logs "$@" ;;
        install-service) cmd_install_service "$@" ;;
        uninstall-service) cmd_uninstall_service "$@" ;;
        -h|--help|help) usage ;;
        *) die "unknown action '$action'. Run 'aura-glass daemon --help' for usage." ;;
    esac
}

main "$@"
